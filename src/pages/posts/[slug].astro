---
import { getLocale, createTranslator, localizePath } from "../../lib/i18n/index";
import { collectionReader } from "../../lib/i18n/content";
const locale = getLocale(Astro.url.pathname);
const t = createTranslator(locale);
const l = (value: string | undefined) => localizePath(value, locale);
const getCollection = collectionReader(locale);

import { getCollection as rawGetCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import WalineComments from "../../components/comments/WalineComments";
import TocSidebar from "../../components/article/TocSidebar.astro";
import { buildTocTree } from "../../components/article/toc-utils";
import PostToc from "../../components/post/PostToc.astro";
import PostPager from "../../components/post/PostPager.astro";
import PostScholarRail from "../../components/post/PostScholarRail.astro";
import ActionPair from "../../components/discover/ActionPair.astro";
import MetaIcon from "../../components/ui/MetaIcon.astro";
import ImageViewer from "../../components/media/ImageViewer.astro";
import type { TufteRailFootnote } from "../../lib/markdown/rehypeTufteFootnotes";
import { TUFTE_MARKDOWN_FOOTNOTES_KEY } from "../../lib/markdown/rehypeTufteFootnotes";
import { resolvePostAuthor } from "../../lib/posts/author";
import { formatPostDisplayDate } from "../../lib/posts/date";
import { getPostSiblings } from "../../lib/posts/navigation";
import { getPostReadingMinutes } from "../../lib/posts/readingTime";
import { buildPostToc } from "../../lib/posts/toc";
import { getPostPath } from "../../lib/posts/urls";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildBlogPostingGraph } from "../../lib/seo/jsonLd";
import { getRelatedPosts } from "../../lib/knowledge/relatedPosts";

interface Props {
  post: CollectionEntry<"posts">;
}

type HeaderMetaItem = {
  icon: "calendar" | "refresh" | "user";
  label: string;
  ariaLabel: string;
};

type HeaderStatItem = {
  icon: "clock" | "tag" | "nodes" | "section";
  label: string;
  ariaLabel: string;
};

export async function getStaticPaths() {
  const posts = await rawGetCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const resolvedAuthor = resolvePostAuthor(post);
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const tocItems = buildPostToc(headings ?? []);
const [allPosts, allTopics] = await Promise.all([
  getCollection("posts", ({ data }) => !data.draft),
  getCollection("topics")
]);
const siblings = getPostSiblings(allPosts, post.id);
const topicTitleBySlug = new Map(allTopics.map((topic) => [topic.id, topic.data.title]));
const relatedPosts = getRelatedPosts(
  {
    id: post.id,
    title: post.data.title,
    summary: post.data.summary,
    date: post.data.date,
    topics: post.data.topics,
    concepts: post.data.concepts
  },
  allPosts.map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    summary: entry.data.summary,
    date: entry.data.date,
    topics: entry.data.topics,
    concepts: entry.data.concepts
  }))
);
const markdownFootnotes = Array.isArray(remarkPluginFrontmatter?.[TUFTE_MARKDOWN_FOOTNOTES_KEY])
  ? (remarkPluginFrontmatter[TUFTE_MARKDOWN_FOOTNOTES_KEY] as TufteRailFootnote[])
  : [];

const readingMinutes = getPostReadingMinutes(post);
const readingTimeLabel = readingMinutes <= 1 ? t("约 1 分钟") : t("约 {0} 分钟", [readingMinutes]);
const tocTree = buildTocTree(tocItems);
const publishedLabel = formatPostDisplayDate(post.data.date);
const updatedLabel = post.data.updated ? formatPostDisplayDate(post.data.updated) : null;
const topicCount = post.data.topics.length;
const conceptCount = post.data.concepts?.length ?? 0;
const sectionCount = tocItems.filter((item) => item.depth === 2).length;
const headerMetaItems = [
  {
    icon: "calendar" as const,
    label: publishedLabel,
    ariaLabel: t("发布日期 {0}", [publishedLabel])
  },
  updatedLabel
    ? {
        icon: "refresh" as const,
        label: updatedLabel,
        ariaLabel: t("更新日期 {0}", [updatedLabel])
      }
    : null,
  {
    icon: "user" as const,
    label: resolvedAuthor.name,
    ariaLabel: t("作者 {0}", [resolvedAuthor.name])
  }
] as Array<HeaderMetaItem | null>;
const headerStats = [
  {
    icon: "clock" as const,
    label: t("{0}阅读", [readingTimeLabel]),
    ariaLabel: t("预计阅读时间 {0}阅读", [readingTimeLabel])
  },
  topicCount > 0
    ? {
        icon: "tag" as const,
        label: t("{0} 个主题", [topicCount]),
        ariaLabel: t("{0} 个主题", [topicCount])
      }
    : null,
  conceptCount > 0
    ? {
        icon: "nodes" as const,
        label: t("{0} 个概念", [conceptCount]),
        ariaLabel: t("{0} 个概念", [conceptCount])
      }
    : sectionCount > 0
      ? {
          icon: "section" as const,
          label: t("{0} 个章节", [sectionCount]),
          ariaLabel: t("{0} 个章节", [sectionCount])
        }
      : null
] as Array<HeaderStatItem | null>;

// JSON-LD: BlogPosting graph. Topics are rendered as visible chips → `about`;
// concepts are only surfaced as a count (not named) so we omit `mentions`.
const canonicalPath = post.data.canonical ?? getPostPath(post.id);
const site = Astro.site;
const structuredData = site
  ? buildBlogPostingGraph({
      siteUrl: site.toString(),
      canonicalUrl: new URL(canonicalPath, site).toString(),
      title: post.data.title,
      description: post.data.summary,
      datePublished: post.data.date,
      dateModified: post.data.updated,
      imageUrl: post.data.cover?.src.src
        ? new URL(post.data.cover.src.src, site).toString()
        : undefined,
      topics: post.data.topics.map((slug) => topicTitleBySlug.get(slug) ?? slug),
      breadcrumbs: [
        { name: t("首页"), url: new URL("/", site).toString() },
        { name: t("主题"), url: new URL("/topics", site).toString() },
        ...(post.data.topics[0]
          ? [
              {
                name: topicTitleBySlug.get(post.data.topics[0]) ?? post.data.topics[0],
                url: new URL(`/topics/${post.data.topics[0]}`, site).toString()
              }
            ]
          : []),
        { name: post.data.title }
      ]
    })
  : undefined;
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  authorMeta={resolvedAuthor.name}
  canonical={post.data.canonical ?? getPostPath(post.id)}
  metaType="article"
  publishedTime={post.data.date}
  modifiedTime={post.data.updated}
  openGraphImage={`/og/posts/${post.id}.png`}
  runtime="reading"
  bodyClass="article-paper-page"
  headerVariant="drawing"
  mainClass="shell--article-reading reading-drawing"
  structuredData={structuredData}
>
  <div class="post-reading-page" data-reading-design="edge">
    <!-- Reading progress bar -->
    <div role="region" aria-label={t("阅读状态")} data-reading-progress-region>
      <div
        class="reading-progress-bar"
        id="reading-progress-bar"
        data-controller="reading-progress"
        role="progressbar"
        aria-label={t("正文阅读进度")}
        aria-valuenow={0}
        aria-valuemin={0}
        aria-valuemax={100}
      >
        <span class="reading-progress-bar__fill" data-reading-progress-fill aria-hidden="true"></span>
      </div>
    </div>
    <div class="post-reading-layout post-reading-layout--scholarly post-reading-layout--tri">
      {tocTree.length > 0 ? (
        <aside class="post-reading-toc-rail" aria-label={t("文章目录")}>
          <TocSidebar items={tocTree} />
        </aside>
      ) : null}

      <div class="post-reading-main">
        <article class="post-reading-article">
          <section class="post-title-card" aria-label={t("文章标题卡片")}>
            <header class="content-section post-header post-header--scholarly">
              <div class="post-header-meta-row">
                <p class="subtle post-header-meta">
                  {(headerMetaItems.filter(Boolean) as HeaderMetaItem[]).map((item) => (
                    <span class="post-header-meta-item">
                      <MetaIcon name={item.icon} class="post-header-meta-icon" />
                      <span class="sr-only">{item.ariaLabel}</span>
                      <span aria-hidden="true">{item.label}</span>
                    </span>
                  ))}
                </p>
              </div>
              <h1>{post.data.title}</h1>
              {post.data.summary ? <p class="post-header-dek">{post.data.summary}</p> : null}
              {headerStats.length > 0 ? (
                <div class="post-header-stats-row" role="group" aria-label={t("文章辅助统计")}>
                  {(headerStats.filter(Boolean) as HeaderStatItem[]).map((item) => (
                    <span class="post-header-stat">
                      <MetaIcon name={item.icon} class="post-header-stat-icon" />
                      <span class="sr-only">{item.ariaLabel}</span>
                      <span aria-hidden="true">{item.label}</span>
                    </span>
                  ))}
                </div>
              ) : null}
              {post.data.topics.length > 0 ? (
                <p class="post-header-topics" role="group" aria-label={t("文章主题标签")}>
                  <span class="post-header-topics-label" aria-hidden="true">
                    <MetaIcon name="tag" class="post-header-topics-icon" />
                  </span>
                  {post.data.topics.map((topicSlug) => (
                    <span class="post-header-topic-item">
                      <a href={l(`/topics/${topicSlug}`)}>#{topicTitleBySlug.get(topicSlug) ?? topicSlug}</a>
                    </span>
                  ))}
                </p>
              ) : null}
              <div class="post-header-divider" aria-hidden="true"></div>
            </header>
            {post.data.cover ? (
              <div class="post-cover post-cover--hero">
                <a
                  class="post-cover-stack post-cover-trigger"
                  href={l(post.data.cover.src.src)}
                  aria-label={t("放大封面：{0}", [post.data.cover.alt])}
                  aria-haspopup="dialog"
                  aria-controls="post-image-viewer"
                  data-image-viewer-trigger
                  data-image-alt={post.data.cover.alt}
                  data-image-width={post.data.cover.src.width}
                  data-image-height={post.data.cover.src.height}
                >
                  <Image
                    src={post.data.cover.src}
                    alt=""
                    aria-hidden="true"
                    class="post-cover-img post-cover-img--ghost"
                    loading="eager"
                    decoding="async"
                    widths={[320, 480, 640, 960]}
                    sizes="(min-width: 1420px) 440px, (min-width: 560px) 400px, 88vw"
                  />
                  <Image
                    src={post.data.cover.src}
                    alt={post.data.cover.alt}
                    class="post-cover-img post-cover-img--main"
                    loading="eager"
                    decoding="async"
                    widths={[320, 480, 640, 960]}
                    sizes="(min-width: 1420px) 440px, (min-width: 560px) 400px, 88vw"
                  />
                </a>
                {post.data.cover.credit ? (
                  <p class="post-cover-credit">{post.data.cover.credit}</p>
                ) : null}
              </div>
            ) : null}
          </section>

          {tocItems.length > 0 ? (
            <div class="post-toc-mobile-container" role="group" aria-label={t("移动端目录")}>
              <PostToc items={tocItems} variant="mobileOnly" />
            </div>
          ) : null}

          <section class="post-body post-body--scholarly" data-post-body>
            <Content />
          </section>
        </article>

        {relatedPosts.length > 0 ? (
          <section class="post-related-notes" aria-label={t("相关笔记")}>
            <h2 class="post-related-notes-title">{t("相关笔记")}</h2>
            <ul class="post-related-notes-list">
              {relatedPosts.map((related) => (
                <li class="post-related-notes-item">
                  <a class="post-related-notes-link" href={l(getPostPath(related.id))}>
                    {related.title}
                  </a>
                  {related.summary ? (
                    <p class="post-related-notes-summary">{related.summary}</p>
                  ) : null}
                </li>
              ))}
            </ul>
          </section>
        ) : null}

        <section class="post-waline-comments-section">
          <WalineComments locale={locale} client:visible path={getPostPath(post.id)} />
        </section>

        <section class="post-reading-family-actions" aria-label={t("继续浏览")}>
          <ActionPair
            actions={[
              siblings.olderPost
                ? {
                    href: getPostPath(siblings.olderPost.id),
                    label: t("下一篇：{0}", [siblings.olderPost.data.title]),
                    variant: "primary",
                    icon: "arrow"
                  }
                : {
                    href: "/archives",
                    label: t("翻阅归档"),
                    variant: "primary",
                    icon: "archive"
                  },
              {
                href: `/topics/${post.data.topics[0]}`,
                label: t("返回主题：{0}", [topicTitleBySlug.get(post.data.topics[0]) ?? post.data.topics[0]]),
                variant: "secondary",
                icon: "topic"
              }
            ]}
          />
        </section>

        <PostPager newerPost={siblings.newerPost} olderPost={siblings.olderPost} />
      </div>

      <aside class="post-reading-rail" aria-label={t("阅读侧栏")}>
        <PostScholarRail
          tocItems={tocItems}
          figures={post.data.figures ?? []}
          markdownFootnotes={markdownFootnotes}
          postSlug={post.id}
          showToc={false}
        />
      </aside>
    </div>
  </div>
  {post.data.cover && <ImageViewer />}
</BaseLayout>
