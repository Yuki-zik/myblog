---
import { getLocale, createTranslator, localizePath, localizeData } from "../lib/i18n/index";
import { collectionReader } from "../lib/i18n/content";
const locale = getLocale(Astro.url.pathname);
const t = createTranslator(locale);
const l = (value: string | undefined) => localizePath(value, locale);
const getCollection = collectionReader(locale);

import {getCollection as rawGetCollection} from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DiscoverShell from "../components/discover/DiscoverShell.astro";
import KnowledgeGraph from "../components/discover/KnowledgeGraph";
import {buildKnowledgeGraph} from "../lib/knowledge/graph";
import {buildReadingTrails, NODE_LABELS, EXPLORE_LABEL} from "../lib/knowledge/explore";
import {buildCollectionPageGraph} from "../lib/seo/jsonLd";
import "../styles/explore.css";
const [posts,topics,concepts]=await Promise.all([getCollection("posts",({data})=>!data.draft),getCollection("topics"),getCollection("concepts")]);
const graph=localizeData(buildKnowledgeGraph(posts,topics,concepts), locale);
const trails=localizeData(buildReadingTrails(graph), locale);
const description=t("从一个问题出发，沿着笔记、主题与概念之间的真实联系，找到下一篇值得读的内容。");
const seoDescription=t("探索 A-Znk 的技术知识网络，沿真实主题、文章和概念关联查找 AI Coding、Agent 工程、段落锚点与知识组织笔记，支持交互浏览与阅读路线。");
const site=Astro.site;
const structuredData=site?buildCollectionPageGraph({siteUrl:site.toString(),canonicalUrl:new URL("/map",site).toString(),title:EXPLORE_LABEL,description:seoDescription,breadcrumbs:[{name:t("首页"),url:new URL("/",site).toString()},{name:EXPLORE_LABEL}]}):undefined;
---
<BaseLayout title={t("漫游 · 想法之间的路径")} description={seoDescription} canonical="/map" runtime="discover" structuredData={structuredData}>
  <DiscoverShell bodyClass="wander-page">
    <header class="wander-hero" data-discover-hero>
      <div class="wander-hero__title">
        <p class="wander-kicker">WANDER / FIELDNOTES</p>
        <h1>{t("漫游")}<span aria-hidden="true">↗</span></h1>
      </div>
      <div class="wander-hero__copy">
        <p class="wander-hero__statement">{t("循着好奇，")}<em>{t("换一条路。")}</em></p>
        <p>{t("选一个想法，沿着真实联系继续阅读。")}</p>
      </div>
      <a class="wander-hero__jump" href={l("#reading-paths")}>{t("沿路线阅读")} <span aria-hidden="true">↓</span></a>
    </header>

    <section class="explore-connections" id="connections" aria-labelledby="explore-connections-title">
      <h2 id="explore-connections-title" class="sr-only">{t("看看想法如何相连")}</h2>
      <KnowledgeGraph graph={graph} locale={locale} client:load />
      <noscript><div class="explore-noscript"><p>{t("交互浏览需要 JavaScript。以下条目均可直接阅读。")}</p>{graph.nodes.map(node=><a href={l(node.url)}><span>{t(NODE_LABELS[node.type])}</span><strong>{node.title}</strong><p>{node.summary}</p></a>)}</div></noscript>
    </section>
    {trails.length>0&&<section class="explore-trails" id="reading-paths" aria-labelledby="explore-trails-title">
      <div class="wander-section-head"><h2 id="explore-trails-title">{t("也可以，沿一条路线")}</h2><span>READING PATHS / {String(trails.length).padStart(2,"0")}</span></div>
      <div class="explore-trails__grid">
        {trails.map((trail,i)=><article class="explore-trail" data-reading-trail>
          <div class="explore-trail__top"><span aria-hidden="true">{String(i+1).padStart(2,"0")}</span><span>{trail.nodes.length} {t("个停靠点")}</span></div>
          <div class="explore-trail__copy">
            <h3><a href={l(`/map?focus=${encodeURIComponent(trail.nodes[0].id)}#connections`)}>{trail.title}<span aria-hidden="true">↗</span></a></h3>
            <details class="explore-trail__description"><summary>{t("路线说明")}</summary><p>{trail.description}</p></details>
          </div>
          <ol aria-label={t("{0}的阅读顺序", [trail.title])}>{trail.nodes.map((node,j)=><li data-kind={node.type}><span aria-hidden="true">{j+1}</span><a href={l(node.url)}>{node.title}</a></li>)}</ol>
        </article>)}
      </div>
    </section>}

    <footer class="wander-endnote"><span>KEEP FOLLOWING THE THREAD.</span><p>{t("这些联系会随笔记一同生长。也可以查看")}<a href={l("/topics")}>{t("主题目录")}</a>{t("，或从")}<a href={l("/archives")}>{t("文章归档")}</a>{t("继续阅读。")}</p></footer>
  </DiscoverShell>
</BaseLayout>
