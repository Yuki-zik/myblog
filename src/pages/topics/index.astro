---
import { getCollection } from "astro:content";
import DrawingIndexShell from "../../components/discover/DrawingIndexShell.astro";
import DrawingPageHeader from "../../components/discover/DrawingPageHeader.astro";
import EmptyState from "../../components/discover/EmptyState.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const [topics, posts] = await Promise.all([
  getCollection("topics"),
  getCollection("posts", ({ data }) => !data.draft)
]);

const sortedTopics = [...topics].sort((a, b) => {
  const orderA = a.data.order ?? Number.POSITIVE_INFINITY;
  const orderB = b.data.order ?? Number.POSITIVE_INFINITY;
  if (orderA !== orderB) {
    return orderA - orderB;
  }
  return a.data.title.localeCompare(b.data.title, "zh-CN");
});

const postCountByTopic = posts.reduce<Record<string, number>>((acc, post) => {
  post.data.topics.forEach((topicSlug) => {
    acc[topicSlug] = (acc[topicSlug] ?? 0) + 1;
  });
  return acc;
}, {});

const topicsPageDescription =
  "按主题查找研究笔记与工程实践，这里汇总每个主题的摘要与相关文章。";
---

<BaseLayout title="主题列表" description={topicsPageDescription} runtime="discover" headerVariant="drawing">
  <DrawingIndexShell kind="topics">
    <DrawingPageHeader
      kicker="Topics"
      title="主题列表"
      description="选择感兴趣的问题，继续阅读相关笔记与实践记录。"
      count={sortedTopics.length}
      countLabel="个主题"
    >
      <a slot="actions" href="/map">知识图谱 <span aria-hidden="true">↗</span></a>
    </DrawingPageHeader>

    <section class="drawing-topic-index" aria-label="主题目录" data-ux-stagger>
      {
        sortedTopics.length === 0 ? (
          <EmptyState title="暂时还没有主题。" body="主题整理完成后，你可以从这里找到相关笔记。" />
        ) : (
          sortedTopics.map((topic, index) => (
            <a
              href={`/topics/${topic.id}`}
              class="drawing-topic-row discover-entity-card"
              data-drawing-topic
              data-ux-reveal="fade-up"
              aria-label={`进入主题：${topic.data.title}`}
            >
              <span class="drawing-topic-row__number">{String(index + 1).padStart(2, "0")}</span>
              <div class="drawing-topic-row__copy">
                <div class="drawing-topic-row__heading">
                  <h2 class="drawing-topic-row__title">{topic.data.title}</h2>
                  <span class="drawing-topic-row__count">{postCountByTopic[topic.id] ?? 0} 篇文章</span>
                </div>
                <p class="drawing-topic-row__summary">{topic.data.summary}</p>
                <p class="drawing-topic-row__rationale"><span aria-hidden="true">WHY / </span>{topic.data.why}</p>
              </div>
            </a>
          ))
        )
      }
    </section>
  </DrawingIndexShell>
</BaseLayout>
