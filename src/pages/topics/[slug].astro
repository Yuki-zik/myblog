---
import { getLocale, createTranslator, localizePath } from "../../lib/i18n/index";
import { createPageLocalizer, collectionReader, entryReader } from "../../lib/i18n/content";
const locale = getLocale(Astro.url.pathname);
const t = createTranslator(locale);
const l = await createPageLocalizer(locale);
const getCollection = collectionReader(locale);
const getEntry = entryReader(locale);

import { getCollection as rawGetCollection, getEntry as rawGetEntry, render, type CollectionEntry } from "astro:content";
import DrawingIndexShell from "../../components/discover/DrawingIndexShell.astro";
import DrawingPageHeader from "../../components/discover/DrawingPageHeader.astro";
import EmptyState from "../../components/discover/EmptyState.astro";
import PostCard from "../../components/post/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditorialFigure from "../../components/media/EditorialFigure.astro";
import ImageViewer from "../../components/media/ImageViewer.astro";
import { topicFigures } from "../../lib/media/editorialFigures";
import "../../styles/topic-imagery.css";
import { buildCollectionPageGraph } from "../../lib/seo/jsonLd";

interface Props {
  topic: CollectionEntry<"topics">;
}

export async function getStaticPaths() {
  const topics = await rawGetCollection("topics");
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: { topic }
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const topicPosts = allPosts
  .filter((post) => post.data.topics.includes(topic.id))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const entryPosts = (
  await Promise.all((topic.data.entryPosts ?? []).map((slug) => getEntry("posts", slug)))
).filter((entry): entry is CollectionEntry<"posts"> => Boolean(entry && !entry.data.draft));

const relatedConceptSlugs = Array.from(new Set(topicPosts.flatMap((post) => post.data.concepts ?? [])));
const relatedConcepts = (
  await Promise.all(relatedConceptSlugs.map((slug) => getEntry("concepts", slug)))
).filter((entry): entry is CollectionEntry<"concepts"> => Boolean(entry));

// "相关主题" is presented as bidirectional: outbound = this topic's own
// relatedTopics[]; inbound = other topics that name THIS topic in theirs
// (relatedTopics[] is a one-way frontmatter edge, so reciprocity is explicit
// and de-duplicated, not assumed symmetric).
const allTopicEntries = await getCollection("topics");
const outboundRelatedTopics = (
  await Promise.all((topic.data.relatedTopics ?? []).map((slug) => getEntry("topics", slug)))
).filter((entry): entry is CollectionEntry<"topics"> => Boolean(entry));
const outboundTopicIds = new Set([topic.id, ...outboundRelatedTopics.map((entry) => entry.id)]);
const inboundRelatedTopics = allTopicEntries.filter(
  (entry) =>
    (entry.data.relatedTopics ?? []).includes(topic.id) && !outboundTopicIds.has(entry.id)
);
const relatedTopics = [...outboundRelatedTopics, ...inboundRelatedTopics];

// Author-selected entries lead the list; each remaining article appears once.
const readingPosts = [...new Map(
  [...entryPosts, ...topicPosts].map((post) => [post.id, post] as const)
).values()];
const topicDescription = topic.data.summary;

const site = Astro.site;
const structuredData = site
  ? buildCollectionPageGraph({
      siteUrl: site.toString(),
      canonicalUrl: new URL(`/topics/${topic.id}`, site).toString(),
      title: topic.data.title,
      description: topic.data.summary,
      breadcrumbs: [
        { name: t("首页"), url: new URL("/", site).toString() },
        { name: t("主题"), url: new URL("/topics", site).toString() },
        { name: topic.data.title }
      ]
    })
  : undefined;
---

<BaseLayout
  title={topic.data.title}
  description={topicDescription}
  runtime="discover"
  headerVariant="drawing"
  openGraphImage={`/og/topics/${topic.id}.png`}
  structuredData={structuredData}
>
  <DrawingIndexShell kind="topic">
    <DrawingPageHeader
      kicker="Topic"
      title={topic.data.title}
      description={topicDescription}
      count={readingPosts.length}
      countLabel={t("篇文章")}
    >
      <a slot="actions" href={l("/topics")}>{t("全部主题")} <span aria-hidden="true">↗</span></a>
    </DrawingPageHeader>

    <section class="discover-section drawing-index-section" data-topic-posts aria-label={t("阅读列表")}>
      <h2 class="drawing-section-title">{t("阅读列表")}</h2>
      {
        readingPosts.length === 0 ? (
          <EmptyState title={t("这个主题还没有笔记。")} body={t("可以先浏览其他主题，找到感兴趣的文章。")} />
        ) : (
          <div class="discover-post-grid topic-reading-grid" data-editorial-grid="lead" data-ux-stagger>
            {readingPosts.map((post) => <PostCard post={post} compactMetadata={true} />)}
          </div>
        )
      }
    </section>

    <section class:list={["discover-section drawing-index-section drawing-topic-about", topicFigures[topic.id] && "drawing-topic-about--illustrated"]}>
      <h2 class="drawing-section-title">{t("关于这个主题")}</h2>
      <div class="discover-rich drawing-topic-about__body">
        <p>{topic.data.why}</p>
        <Content />
      </div>
      {topicFigures[topic.id] && <EditorialFigure figure={topicFigures[topic.id]} class="drawing-topic-about__figure" sizes="(max-width: 760px) calc(100vw - 3rem), 360px" />}
    </section>

    {
      relatedConcepts.length > 0 ? (
        <section class="discover-section drawing-index-section" data-topic-concepts>
          <h2 class="drawing-section-title">{t("相关概念")}</h2>
          <div class="discover-mini-grid drawing-related-grid" data-ux-stagger>
            {relatedConcepts.map((concept) => (
              <a href={l(`/concepts/${concept.id}`)} class="discover-mini-card drawing-related-link" data-ux-reveal="fade-up">
                <h3>{concept.data.title}</h3>
                <p>{concept.data.summary}</p>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }

    {
      relatedTopics.length > 0 ? (
        <section class="discover-section drawing-index-section" data-topic-related>
          <h2 class="drawing-section-title">{t("相关主题")}</h2>
          <div class="discover-mini-grid drawing-related-grid" data-ux-stagger>
            {relatedTopics.map((entry) => (
              <a href={l(`/topics/${entry.id}`)} class="discover-mini-card drawing-related-link" data-ux-reveal="fade-up">
                <h3>{entry.data.title}</h3>
                <p>{entry.data.summary}</p>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }
  </DrawingIndexShell>
  {topicFigures[topic.id] && <ImageViewer />}
</BaseLayout>
