---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import DiscoverShell from "../../components/discover/DiscoverShell.astro";
import EmptyState from "../../components/discover/EmptyState.astro";
import PageHero from "../../components/discover/PageHero.astro";
import SectionHead from "../../components/discover/SectionHead.astro";
import PostCard from "../../components/post/PostCard.astro";
import { formatPostDisplayDate } from "../../lib/posts/date";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  topic: CollectionEntry<"topics">;
}

export async function getStaticPaths() {
  const topics = await getCollection("topics");
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: { topic }
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const topicPosts = allPosts
  .filter((post) => post.data.topics.includes(topic.id))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const entryPosts = (
  await Promise.all((topic.data.entryPosts ?? []).map((slug) => getEntry("posts", slug)))
).filter((entry): entry is CollectionEntry<"posts"> => Boolean(entry && !entry.data.draft));

const relatedConceptSlugs = Array.from(new Set(topicPosts.flatMap((post) => post.data.concepts ?? [])));
const relatedConcepts = (
  await Promise.all(relatedConceptSlugs.map((slug) => getEntry("concepts", slug)))
).filter((entry): entry is CollectionEntry<"concepts"> => Boolean(entry));

const relatedTopics = (
  await Promise.all((topic.data.relatedTopics ?? []).map((slug) => getEntry("topics", slug)))
).filter((entry): entry is CollectionEntry<"topics"> => Boolean(entry));

const primaryEntry = entryPosts[0] ?? topicPosts[0] ?? null;
const additionalEntryPosts = entryPosts.slice(1);
const topicDescription = `${topic.data.summary} ${topic.data.why}`;
---

<BaseLayout
  title={`${topic.data.title} | 主题地图`}
  description={topicDescription}
  runtime="discover"
>
  <DiscoverShell>
    <PageHero
      variant="split"
      kicker="Discover / Topic"
      title={topic.data.title}
      description={topicDescription}
      actions={[
        primaryEntry
          ? {
              href: `/posts/${primaryEntry.id}`,
              label: `从《${primaryEntry.data.title}》开始`,
              variant: "primary",
              icon: "arrow"
            }
          : {
              href: "/archives",
              label: "浏览归档",
              variant: "primary",
              icon: "archive"
            },
        {
          href: "/topics",
          label: "返回主题列表",
          variant: "secondary",
          icon: "topic"
        }
      ]}
    >
      <div slot="aside">
        <div class="discover-hero__panel-copy">
          <p class="discover-hero__panel-label">Topic Thesis</p>
          <p>{topic.data.why}</p>
        </div>
        <div class="discover-hero__panel-stats">
          <div class="discover-hero__panel-stat">
            <strong>{String(topicPosts.length).padStart(2, "0")}</strong>
            <span>相关文章</span>
          </div>
          <div class="discover-hero__panel-stat">
            <strong>{String(relatedConcepts.length).padStart(2, "0")}</strong>
            <span>相关概念</span>
          </div>
          <div class="discover-hero__panel-stat">
            <strong>{String(entryPosts.length).padStart(2, "0")}</strong>
            <span>入门文章</span>
          </div>
          <div class="discover-hero__panel-stat">
            <strong>{String(relatedTopics.length).padStart(2, "0")}</strong>
            <span>相关主题</span>
          </div>
        </div>
      </div>
    </PageHero>

    <section class="discover-section">
      <SectionHead
        kicker="Overview"
        title="主题说明"
        description="保留原始长文说明，但将它放进 discover runtime 的阅读面板中，避免主题详情重新掉回旧的裸 section。"
      />
      <div class="discover-surface discover-rich">
        <Content />
      </div>
    </section>

    <section class="discover-section">
      <SectionHead
        kicker="Entry"
        title="入门路径"
        description="优先给出作者明确指定的入口文章；如果主题尚未整理完成，就退回到最新相关文章。"
        countLabel={`${entryPosts.length || topicPosts.length} items`}
      />
      {
        primaryEntry ? (
          <div class="discover-stream-list">
            <a href={`/posts/${primaryEntry.id}`} class="discover-surface discover-stream-item">
              <span class="discover-stream-item__eyebrow">Primary Entry</span>
              <div class="discover-stream-item__row">
                <h3 class="discover-stream-item__title">{primaryEntry.data.title}</h3>
                <span class="discover-inline-meta">{formatPostDisplayDate(primaryEntry.data.date)}</span>
              </div>
              <p class="discover-stream-item__summary">{primaryEntry.data.summary ?? "从这里进入这个主题的第一层脉络。"}</p>
            </a>

            {additionalEntryPosts.map((post) => (
              <a href={`/posts/${post.id}`} class="discover-surface discover-stream-item">
                <span class="discover-stream-item__eyebrow">Entry Extension</span>
                <div class="discover-stream-item__row">
                  <h3 class="discover-stream-item__title">{post.data.title}</h3>
                  <span class="discover-inline-meta">{formatPostDisplayDate(post.data.date)}</span>
                </div>
                <p class="discover-stream-item__summary">{post.data.summary ?? "作为入门路径的后续延展阅读。"}</p>
              </a>
            ))}
          </div>
        ) : (
          <EmptyState title="暂无入门文章。" body="这个主题还没有显式指定入门路径，后续会在整理主题地图时补上。" />
        )
      }
    </section>

    <section class="discover-section" data-topic-posts>
      <SectionHead
        kicker="Posts"
        title="相关文章"
        description="相关文章继续使用统一的 PostCard / PostCover 体系，但现在落在 discover 页面结构中，而不是孤立的旧式内容区块。"
        countLabel={`${topicPosts.length} posts`}
      />
      {
        topicPosts.length === 0 ? (
          <EmptyState title="该主题下暂无文章。" body="等文章发布后，这里会自动接入统一的文章卡片列表。" />
        ) : (
          <div class="discover-post-grid" data-ux-stagger>
            {topicPosts.map((post) => <PostCard post={post} />)}
          </div>
        )
      }
    </section>

    <section class="discover-section">
      <SectionHead
        kicker="Concepts"
        title="相关概念"
        description="主题下文章标注出的概念会汇总成二级入口，帮助读者从叙述层切回概念层。"
        countLabel={`${relatedConcepts.length} linked`}
      />
      {
        relatedConcepts.length === 0 ? (
          <EmptyState title="暂无相关概念。" body="当前主题文章还没有标注概念节点，后续补标后会自动出现在这里。" />
        ) : (
          <div class="discover-mini-grid" data-ux-stagger>
            {relatedConcepts.map((concept) => (
              <a href={`/concepts/${concept.id}`} class="discover-surface discover-mini-card" data-ux-reveal="fade-up">
                <span class="discover-mini-card__meta">Concept</span>
                <h3>{concept.data.title}</h3>
                <p>{concept.data.summary}</p>
              </a>
            ))}
          </div>
        )
      }
    </section>

    <section class="discover-section">
      <SectionHead
        kicker="Network"
        title="相关主题"
        description="显式关联主题保持同一套卡片语言，避免相关主题只退化成底部标签列表。"
        countLabel={`${relatedTopics.length} related`}
      />
      {
        relatedTopics.length === 0 ? (
          <EmptyState title="暂无显式关联主题。" body="当主题地图完成交叉链接后，这里会继续展开成更完整的网络。" />
        ) : (
          <div class="discover-mini-grid" data-ux-stagger>
            {relatedTopics.map((entry) => (
              <a href={`/topics/${entry.id}`} class="discover-surface discover-mini-card" data-ux-reveal="fade-up">
                <span class="discover-mini-card__meta">Topic</span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.summary}</p>
              </a>
            ))}
          </div>
        )
      }
    </section>
  </DiscoverShell>
</BaseLayout>
