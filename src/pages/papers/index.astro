---
import { getCollection } from "astro:content";
import ContentDossier from "../../components/discover/ContentDossier.astro";
import DrawingIndexShell from "../../components/discover/DrawingIndexShell.astro";
import DrawingPageHeader from "../../components/discover/DrawingPageHeader.astro";
import EditorialFigure from "../../components/media/EditorialFigure.astro";
import ImageViewer from "../../components/media/ImageViewer.astro";
import PaperFigure from "../../components/papers/PaperFigure.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { paperReferenceFigure } from "../../lib/media/editorialFigures";
import { buildCollectionPageGraph } from "../../lib/seo/jsonLd";
import "../../styles/reference-collections.css";
import "../../styles/publication-dossiers.css";

const papers = (await getCollection("papers", ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.year !== b.data.year) {
    return b.data.year - a.data.year;
  }
  return a.data.title.localeCompare(b.data.title, "zh-CN");
});
const paperGroups = [...new Set(papers.map((paper) => paper.data.year))].map((year) => ({
  year,
  papers: papers.filter((paper) => paper.data.year === year)
}));
const description = "按年份浏览论文，查找研究摘要、发表信息与原文。";
const seoDescription = "汇总已公开研究论文，包括多语种语音隐私保护、通用对抗扰动、双激发碳点与机器学习检测；按年份查看摘要、期刊信息、DOI 和原文链接。";
const site = Astro.site;
const canonicalUrl = site ? new URL("/papers", site).toString() : "";
const structuredData = site
  ? buildCollectionPageGraph({
      siteUrl: site.toString(),
      canonicalUrl,
      title: "论文与研究成果",
      description: seoDescription,
      breadcrumbs: [
        { name: "首页", url: new URL("/", site).toString() },
        { name: "论文与研究成果" }
      ]
    })
  : undefined;

const statusLabels = {
  prototype: "页面样稿",
  preprint: "预印本",
  accepted: "已接收",
  published: "已发表"
} as const;

const resourceLabels = {
  publisher: "Publisher",
  pdf: "PDF",
  code: "Code",
  project: "Project",
  data: "Data",
  supplement: "Supplement",
  slides: "Slides",
  video: "Video",
  demo: "Demo"
} as const;
---

<BaseLayout
  title="论文与研究成果"
  description={seoDescription}
  canonical="/papers"
  runtime="discover"
  headerVariant="drawing"
  structuredData={structuredData}
>
  <DrawingIndexShell kind="papers" bodyClass="papers-index-page papers-index-dossiers">
    <DrawingPageHeader
      kicker="Research / Papers"
      title="论文与研究成果"
      description={description}
      count={papers.length}
      countLabel="项研究成果"
    >
      <a slot="actions" href="/author">研究者简介</a>
    </DrawingPageHeader>

    <section class="discover-section">
      <div class="paper-year-list" data-ux-stagger>
        {paperGroups.map((group) => (
          <section class="paper-year-group" data-paper-year={group.year} data-ux-reveal="fade-up">
            <header class="paper-year-heading">
              <h2>{group.year}</h2>
              <span>{String(group.papers.length).padStart(2, "0")} records</span>
            </header>

            <div class="publication-dossier-list">
              {group.papers.map((paper) => (
                <ContentDossier
                  index={String(papers.findIndex((entry) => entry.id === paper.id) + 1).padStart(2, "0")}
                  label="PUBLICATION / 论文档案"
                  title={paper.data.title}
                  href={`/papers/${paper.id}`}
                  class="publication-dossier"
                  variant="compact"
                  copyClass="paper-index-row__main"
                  titleClass="publication-dossier__title"
                  detailsLabel="引用与研究关键词"
                  data-paper-card
                  data-publication-dossier
                  aria-label={paper.data.title}
                >
                  <div slot="meta" class="paper-index-row__meta">
                    <span class={`paper-status paper-status--${paper.data.status}`} data-paper-status>
                      {statusLabels[paper.data.status]}
                    </span>
                    <span title={paper.data.venue?.name}>
                      {paper.data.venue?.short ?? paper.data.venue?.name ?? "Research record"} · {paper.data.year}
                    </span>
                  </div>
                  {paper.data.subtitle ? <p class="publication-dossier__subtitle">{paper.data.subtitle}</p> : null}
                  <p class="paper-index-row__authors">
                    {paper.data.authors.map((author, index) => (
                      <>
                        {index > 0 ? <span aria-hidden="true">, </span> : null}
                        {author.url ? (
                          <a href={author.url} class:list={{ "is-self": author.self }}>{author.name}</a>
                        ) : (
                          <span class:list={{ "is-self": author.self }}>{author.name}</span>
                        )}
                      </>
                    ))}
                  </p>
                  {paper.data.cover ? (
                    <div class="publication-illustrated-overview">
                      <p class="paper-index-row__summary">{paper.data.abstract}</p>
                      <PaperFigure cover={paper.data.cover} sizes="(max-width: 1050px) calc(100vw - 96px), 640px" />
                    </div>
                  ) : <p class="paper-index-row__summary">{paper.data.abstract}</p>}

                  <nav slot="footer" class="paper-index-row__resources" aria-label={`${paper.data.title} 资源`}>
                    <a class="paper-resource-link paper-resource-link--detail" href={`/papers/${paper.id}`}>
                      阅读详情
                      <span aria-hidden="true">↗</span>
                    </a>
                    {paper.data.resources.map((resource) => (
                      <a class="paper-resource-link" href={resource.url} target="_blank" rel="noreferrer">
                        {resource.label ?? resourceLabels[resource.type]}
                      </a>
                    ))}
                  </nav>

                  <div slot="details" class="publication-dossier__reference">
                    <div class="publication-dossier__citation">
                      <p class="publication-dossier__label">Citation / 引用</p>
                      <p data-publication-citation>
                        {paper.data.citation ?? `${paper.data.authors.map((author) => author.name).join(", ")}. ${paper.data.title}. ${paper.data.venue?.name ?? "Preprint"}, ${paper.data.year}.`}
                      </p>
                      {paper.data.identifiers?.doi ? (
                        <p class="publication-dossier__doi">
                          <span>DOI</span>
                          <a href={`https://doi.org/${paper.data.identifiers.doi}`} target="_blank" rel="noreferrer">{paper.data.identifiers.doi}</a>
                        </p>
                      ) : null}
                    </div>
                    {paper.data.keywords?.length ? (
                      <div>
                        <p class="publication-dossier__label">Keywords / 关键词</p>
                        <ul class="paper-keywords paper-index-row__keywords" aria-label="论文研究关键词">
                          {paper.data.keywords.map((keyword) => <li>{keyword}</li>)}
                        </ul>
                      </div>
                    ) : null}
                  </div>
                </ContentDossier>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <aside class="paper-historical-reference" aria-labelledby="paper-reference-title">
      <div class="paper-historical-reference__copy">
        <p class="paper-historical-reference__eyebrow">历史参考图版 / 1843</p>
        <h2 id="paper-reference-title">把计算过程留在纸上</h2>
        <p>Ada Lovelace 在 Note G 中，把伯努利数计算展开为操作步骤、变量与中间结果。循着这张表，可以看到一个计算过程如何被逐步记录。</p>
        <p class="paper-historical-reference__invitation">点开图版，细看其中的操作序列。</p>
      </div>
      <EditorialFigure
        figure={paperReferenceFigure}
        compact
        class="paper-historical-reference__figure"
        sizes="(max-width: 600px) 220px, 280px"
      />
    </aside>
  </DrawingIndexShell>
  <ImageViewer />
</BaseLayout>
