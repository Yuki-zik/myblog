---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import HomeReferenceFooter from "../components/home/HomeReferenceFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  pickFeaturedHomePost,
  pickRecentHomePosts
} from "../lib/home/selectors";
import { getPostDateISO } from "../lib/posts/date";
import { SITE_AUTHOR_PROFILE, SITE_NAME, SITE_DESCRIPTION } from "../lib/site";

const [topics, posts, concepts] = await Promise.all([
  getCollection("topics"),
  getCollection("posts", ({ data }) => !data.draft),
  getCollection("concepts")
]);

const sortedTopics = [...topics].sort((a, b) => {
  const orderA = a.data.order ?? Number.POSITIVE_INFINITY;
  const orderB = b.data.order ?? Number.POSITIVE_INFINITY;

  if (orderA !== orderB) {
    return orderA - orderB;
  }

  return a.data.title.localeCompare(b.data.title, "zh-CN");
});

const topicTitleBySlug = new Map(sortedTopics.map((topic) => [topic.id, topic.data.title]));

const postCountByTopic = posts.reduce<Record<string, number>>((acc, post) => {
  post.data.topics.forEach((topicSlug) => {
    acc[topicSlug] = (acc[topicSlug] ?? 0) + 1;
  });

  return acc;
}, {});

const featuredPost = pickFeaturedHomePost(posts);
const recentPosts = pickRecentHomePosts(posts, featuredPost?.id, 5);
const homeDomainsLoopable = sortedTopics.length > 4;

const featuredTopicLabel = featuredPost?.data.topics[0]
  ? topicTitleBySlug.get(featuredPost.data.topics[0]) ?? featuredPost.data.topics[0]
  : "精选文章";

const primaryCta = {
  href: "/topics",
  label: "按主题探索"
};

const secondaryCta = {
  href: "/papers",
  label: "论文与研究成果",
  external: false
};

const terminalTracks = SITE_AUTHOR_PROFILE.researchTracks?.slice(0, 3) ?? [];
const homeDescription = SITE_DESCRIPTION;
---

<BaseLayout
  title={`${SITE_NAME} | 大模型系统、模型安全与 Agent 工程`}
  description={homeDescription}
  runtime="discover"
  mainClass="shell--home-reference relative"
  footerVariant="none"
>
  <div class="home-reference relative min-h-screen" data-home-reference-root>
    <div class="home-reference__ambient fixed inset-0 z-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="home-reference__grid absolute inset-0"></div>
      <div class="home-reference__grain absolute inset-0"></div>
      <div class="home-reference__orb home-reference__orb--blue absolute rounded-full"></div>
      <div class="home-reference__orb home-reference__orb--amber absolute rounded-full"></div>
    </div>

    <div class="home-reference__body relative z-[1] mx-auto flex w-full max-w-[70rem] flex-col gap-16 px-6 pt-14 pb-0">
      <section
        class="home-reference-hero relative grid grid-cols-12 items-start gap-12"
        aria-label="首页视觉主叙事"
        data-ux-stagger
      >
        <div class="home-reference-hero__copy col-span-7 flex flex-col gap-6" data-ux-reveal="fade-up">
          <div class="home-reference-hero__kicker inline-flex items-center gap-2 text-[0.8125rem] font-medium">
            <span>A-Znk 的研究与实践</span>
          </div>

          <h1 class="home-reference-hero__title">
            A-Znk
            <span class="home-reference-hero__title-note">研究与工程笔记</span>
          </h1>

          <p class="home-reference-hero__topics">大模型系统 · 模型安全 · Agent 工程</p>

          <p class="home-reference-hero__description max-w-[36rem] text-[1.0625rem] leading-[1.8]">
            我是 A-Znk，关注大模型安全与 Agent 工程，记录研究问题、实验和系统实践。
            你可以沿主题阅读笔记，也可以直接查看论文与研究成果。
          </p>

          <div class="home-reference-hero__actions flex flex-wrap items-center gap-3">
            <a
              href={primaryCta.href}
              class="home-reference-hero__button home-reference-hero__button--primary inline-flex items-center gap-2 rounded-[999px] border border-transparent px-6 py-3 font-(family-name:--font-ui) text-[0.875rem] leading-none font-medium"
            >
              <span>{primaryCta.label}</span>
              <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
            <a
              href={secondaryCta.href}
              class="home-reference-hero__button home-reference-hero__button--secondary inline-flex items-center gap-2 rounded-[999px] border border-transparent px-6 py-3 font-(family-name:--font-ui) text-[0.875rem] leading-none font-medium"
              target={secondaryCta.external ? "_blank" : undefined}
              rel={secondaryCta.external ? "noreferrer noopener" : undefined}
            >
              <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="2"></circle>
                <circle cx="18" cy="6" r="2"></circle>
                <circle cx="12" cy="18" r="2"></circle>
                <path d="M8 6h8"></path>
                <path d="m7.7 7.1 3.2 8.1"></path>
                <path d="m16.3 7.1-3.2 8.1"></path>
              </svg>
              <span>{secondaryCta.label}</span>
            </a>
          </div>
        </div>

        <div class="home-reference-terminal-wrap sticky top-28 z-10 col-span-5 self-start" data-ux-reveal="fade-up">
          <div class="home-reference-card home-reference-terminal relative">
            <details class="home-reference-terminal__shell" data-home-reference-terminal data-home-research-signature>
              <summary class="home-reference-terminal__header">
                <span class="home-reference-terminal__lights" aria-hidden="true">
                  <span class="home-reference-terminal__light home-reference-terminal__light--red"></span>
                  <span class="home-reference-terminal__light home-reference-terminal__light--amber"></span>
                  <span class="home-reference-terminal__light home-reference-terminal__light--green"></span>
                </span>
                <span class="home-reference-terminal__filename">研究签名 · research.ts</span>
              </summary>

              <div class="home-reference-terminal__body">
                <p class="home-reference-terminal__line"><span class="home-reference-terminal__kw">const</span> <span class="home-reference-terminal__fn">research</span> = {"{"}</p>
                <p class="home-reference-terminal__line home-reference-terminal__line--indent home-reference-terminal__comment">// 当前主研究轨道</p>
                <p class="home-reference-terminal__line home-reference-terminal__line--indent">focus: [</p>
                {terminalTracks.map((track) => (
                  <p class="home-reference-terminal__line home-reference-terminal__line--indent-2"><span class="home-reference-terminal__string">"{track.title}"</span>,</p>
                ))}
                <p class="home-reference-terminal__line home-reference-terminal__line--indent">],</p>
                <p class="home-reference-terminal__line home-reference-terminal__line--indent">notes: <span class="home-reference-terminal__string">"/topics"</span>,</p>
                <p class="home-reference-terminal__line home-reference-terminal__line--indent">papers: <span class="home-reference-terminal__string">"/papers"</span></p>
                <p class="home-reference-terminal__line">{"}"}</p>
                <div class="home-reference-terminal__meta">
                  <span data-research-count="posts">{posts.length} posts indexed</span>
                  <span data-research-count="topics">{topics.length} topics mapped</span>
                  <span data-research-count="concepts">{concepts.length} concepts linked</span>
                </div>
                <div class="home-reference-terminal__prompt">
                  <span>$</span>
                  <span class="home-reference-terminal__cursor" aria-hidden="true"></span>
                </div>
              </div>
            </details>
          </div>
        </div>
      </section>

      <section data-home-domains data-controller="domains-carousel" data-ux-stagger>
        <div class="home-reference-section-head mb-6 flex items-center justify-between gap-4 border-b border-b-(--border-default) pb-4" data-ux-reveal="fade-up">
          <h2>关注领域</h2>
          <div class="home-reference-domain-toolbar inline-flex items-center gap-[0.9rem]">
            <span>{String(sortedTopics.length).padStart(2, "0")} 个主题</span>
            {
              homeDomainsLoopable ? (
                <div class="home-reference-domain-nav inline-flex items-center gap-[0.45rem]" data-home-domains-nav>
                  <button
                    type="button"
                    class="home-reference-domain-nav__button inline-flex size-8 items-center justify-center rounded-full disabled:cursor-default disabled:opacity-[0.36]"
                    data-home-domains-prev
                    aria-label="查看上一组主题"
                  >
                    <span aria-hidden="true">←</span>
                  </button>
                  <button
                    type="button"
                    class="home-reference-domain-nav__button inline-flex size-8 items-center justify-center rounded-full disabled:cursor-default disabled:opacity-[0.36]"
                    data-home-domains-next
                    aria-label="查看下一组主题"
                  >
                    <span aria-hidden="true">→</span>
                  </button>
                </div>
              ) : null
            }
          </div>
        </div>

        <div
          class="home-reference-domains-viewport"
          data-home-domains-viewport
          tabindex="0"
          role="group"
          aria-label="关注领域循环列表"
        >
          <div class="home-reference-domain-grid" data-home-domains-track>
            {sortedTopics.map((topic, index) => {
              const cardNumber = String(index + 1).padStart(2, "0");

              return (
                <a
                  href={`/topics/${topic.id}`}
                  class="home-reference-domain-item"
                  data-home-domain-card
                  data-ux-reveal="fade-up"
                  aria-label={`进入主题：${topic.data.title}`}
                >
                  <div class="home-reference-card home-reference-domain-card relative flex h-full flex-col p-5">
                    <div class="home-reference-domain-card__head mb-3 flex items-start justify-between">
                      <span class="home-reference-domain-card__glyph" aria-hidden="true">
                        {
                          index === 0 ? (
                            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <rect x="4" y="4" width="16" height="16" rx="3"></rect>
                              <path d="M9 9h6v6H9z"></path>
                              <path d="M9 2v2"></path>
                              <path d="M15 2v2"></path>
                              <path d="M9 20v2"></path>
                              <path d="M15 20v2"></path>
                            </svg>
                          ) : index === 1 ? (
                            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <ellipse cx="12" cy="6" rx="7" ry="3"></ellipse>
                              <path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"></path>
                              <path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"></path>
                            </svg>
                          ) : index === 2 ? (
                            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="6" cy="12" r="2"></circle>
                              <circle cx="18" cy="6" r="2"></circle>
                              <circle cx="18" cy="18" r="2"></circle>
                              <path d="M8 11 16 7"></path>
                              <path d="m8 13 8 4"></path>
                            </svg>
                          ) : (
                            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M4 6h16"></path>
                              <path d="M7 12h10"></path>
                              <path d="M9 18h6"></path>
                            </svg>
                          )
                        }
                      </span>
                      <span class="home-reference-domain-card__id font-(family-name:--font-ui) text-[0.75rem]" data-home-domain-id>{cardNumber}</span>
                    </div>

                    <h3 data-home-domain-title>{topic.data.title}</h3>
                    <p class="text-[0.875rem] leading-[1.6]" data-home-domain-summary>{topic.data.summary}</p>
                    <p class="home-reference-domain-card__meta text-[0.875rem] leading-[1.6]" data-home-domain-meta>
                      相关文章 {postCountByTopic[topic.id] ?? 0} 篇
                    </p>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>

      <section class="home-reference-publishing-grid grid gap-8" data-ux-stagger>
        <div data-home-featured-post data-ux-reveal="fade-up">
          <div class="home-reference-section-head mb-6 flex items-center justify-between gap-4 border-b border-b-(--border-default) pb-4">
            <h2>近期得意之作</h2>
          </div>

          {
            featuredPost ? (
              <a href={`/posts/${featuredPost.id}`} class="home-reference-card home-reference-featured-card relative p-5">
                <div class="home-featured-cover-stack post-cover post-cover--featured" data-home-featured-cover data-post-cover="featured" data-post-cover-manual={featuredPost.data.cover?.src ? "true" : "false"}>
                  {
                    featuredPost.data.cover?.src ? (
                      <>
                        <Image
                          src={featuredPost.data.cover.src}
                          alt=""
                          width={1600}
                          height={1200}
                          class="home-featured-cover-image home-featured-cover-image--ghost post-cover-img post-cover-img--ghost"
                          loading="eager"
                          decoding="async"
                          aria-hidden="true"
                          sizes="(max-width: 720px) calc(100vw - 2rem), (max-width: 1120px) calc(100vw - 4rem), 500px"
                        />
                        <Image
                          src={featuredPost.data.cover.src}
                          alt={featuredPost.data.cover.alt}
                          width={1600}
                          height={1200}
                          class="home-featured-cover-image home-featured-cover-image--main post-cover-img post-cover-img--main"
                          loading="eager"
                          decoding="async"
                          sizes="(max-width: 720px) calc(100vw - 2rem), (max-width: 1120px) calc(100vw - 4rem), 500px"
                        />
                      </>
                    ) : (
                      <div class="home-featured-cover-fallback relative z-[1] grid h-full w-full place-items-center rounded-[0.75rem] font-(family-name:--font-ui) text-[0.75rem] tracking-[0.12em] uppercase">Featured Note</div>
                    )
                  }
                </div>

                <div class="home-reference-featured-card__copy home-reference-featured-card__body flex flex-col gap-3">
                  <div class="home-reference-featured-card__eyebrow inline-flex items-center gap-[0.35rem] font-(family-name:--font-ui) text-[0.75rem] font-medium">{featuredTopicLabel}</div>
                  <h3 class="home-reference-featured-card__title">{featuredPost.data.title}</h3>
                  {featuredPost.data.summary ? (
                    <p class="home-reference-featured-card__summary text-[0.875rem] leading-[1.7]">{featuredPost.data.summary}</p>
                  ) : null}
                </div>
              </a>
            ) : (
              <p class="home-reference-empty rounded-[1rem] px-5 py-6 text-[0.95rem]">暂时还没有可展示的精选文章。</p>
            )
          }
        </div>

        <div data-home-recent-posts data-ux-reveal="fade-up">
          <div class="home-reference-section-head mb-6 flex items-center justify-between gap-4 border-b border-b-(--border-default) pb-4">
            <h2>近期碎片</h2>
            <a href="/archives" class="home-reference-section-link inline-flex items-center gap-1">
              <span>查看全部</span>
              <svg class="h-3 w-3" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>

          {recentPosts.length === 0 ? (
            <p class="home-reference-empty rounded-[1rem] px-5 py-6 text-[0.95rem]">暂时还没有更多文章。</p>
          ) : (
            <div class="home-reference-recent-list flex flex-col">
              {recentPosts.map((post) => (
                <a href={`/posts/${post.id}`} class="home-reference-recent-item group relative flex items-center gap-6 overflow-hidden" data-home-recent-item>
                  <div class="home-reference-recent-item__meta flex w-48 shrink-0 flex-wrap items-center gap-2">
                    <span class="home-reference-recent-item__date font-(family-name:--font-ui) text-[0.75rem]">{getPostDateISO(post.data.date)}</span>
                    <span class="home-reference-recent-item__tag inline-flex min-h-6 items-center justify-center rounded-full px-2.5 py-1 font-(family-name:--font-ui) text-[0.6875rem] leading-none">
                      {topicTitleBySlug.get(post.data.topics[0]) ?? post.data.topics[0]}
                    </span>
                  </div>
                  <h3 class="home-reference-recent-item__title flex-auto pr-8">{post.data.title}</h3>
                  <span
                    class="home-reference-recent-item__arrow absolute top-1/2 right-5 opacity-0 group-hover:opacity-100"
                    aria-hidden="true"
                  >
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14"></path>
                      <path d="m12 5 7 7-7 7"></path>
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>

      <HomeReferenceFooter variant="full-bleed" />
    </div>
  </div>
</BaseLayout>
