---
import { getLocale, createTranslator, localizePath, localizeData } from "../lib/i18n/index";
import { collectionReader } from "../lib/i18n/content";
const locale = getLocale(Astro.url.pathname);
const t = createTranslator(locale);
const l = (value: string | undefined) => localizePath(value, locale);
const getCollection = collectionReader(locale);
const SITE_AUTHOR_PROFILE = localizeData(SOURCE_SITE_AUTHOR_PROFILE, locale);

import { getCollection as rawGetCollection } from "astro:content";
import DiscoverShell from "../components/discover/DiscoverShell.astro";
import EmptyState from "../components/discover/EmptyState.astro";
import SectionHead from "../components/discover/SectionHead.astro";
import ContentDossier from "../components/discover/ContentDossier.astro";
import PostCard from "../components/post/PostCard.astro";
import EditorialFigure from "../components/media/EditorialFigure.astro";
import ImageViewer from "../components/media/ImageViewer.astro";
import PaperFigure from "../components/papers/PaperFigure.astro";
import { SITE_AUTHOR_PROFILE as SOURCE_SITE_AUTHOR_PROFILE } from "../lib/site";
import { researchFigures } from "../lib/media/editorialFigures";
import { resolvePostAuthor } from "../lib/posts/author";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/author-atlas.css";
import "../styles/author-dossiers.css";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const authorPosts = [...posts]
  .filter((post) => resolvePostAuthor(post).name === SITE_AUTHOR_PROFILE.name)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const topicCount = new Set(authorPosts.flatMap((post) => post.data.topics)).size;
const socialNetworks = SITE_AUTHOR_PROFILE.socialNetworks ?? [];
const authorPublications = (await getCollection("papers", ({ data }) => !data.draft))
  .filter((paper) =>
    (paper.data.status === "published" || paper.data.status === "accepted") &&
    paper.data.authors.some((author) => author.self)
  )
  .sort((a, b) => b.data.year - a.data.year);
const selectedPapers = authorPublications.slice(0, 3);

const authorContactEntries = [
  SITE_AUTHOR_PROFILE.email
    ? {
        label: "Email",
        value: SITE_AUTHOR_PROFILE.email,
        href: `mailto:${SITE_AUTHOR_PROFILE.email}`
      }
    : null,
  SITE_AUTHOR_PROFILE.socials?.github
    ? {
        label: "GitHub",
        value: `github.com/${SITE_AUTHOR_PROFILE.socials.github}`,
        href: `https://github.com/${SITE_AUTHOR_PROFILE.socials.github}`,
        external: true
      }
    : null,
  {
    label: "Google Scholar",
    value: "scholar.google.com/citations?user=NTwrnCIAAAAJ&hl=zh-CN",
    href: "https://scholar.google.com/citations?user=NTwrnCIAAAAJ&hl=zh-CN",
    external: true
  }
].filter(
  (
    entry
  ): entry is {
    label: string;
    value: string;
    href: string;
    external?: boolean;
  } => entry !== null
);
---

<BaseLayout
  title={t("{0} | 作者", [SITE_AUTHOR_PROFILE.name])}
  description={SITE_AUTHOR_PROFILE.intro ?? SITE_AUTHOR_PROFILE.bioShort}
  authorMeta={SITE_AUTHOR_PROFILE.name}
  runtime="discover"
>
  <DiscoverShell bodyClass="discover-editorial author-atlas">
    <section class="author-atlas-hero" data-discover-hero aria-labelledby="author-atlas-name">
      <header class="author-atlas-hero__masthead">
        <div class="author-atlas-hero__locator" aria-hidden="true">
          <span>PERSONAL RESEARCH / FIELDNOTES</span>
          <span>{t("01 — 作者")}</span>
        </div>
        <h1 id="author-atlas-name" class="author-atlas-hero__name">
          {SITE_AUTHOR_PROFILE.name}
          <span>{SITE_AUTHOR_PROFILE.publicationName}</span>
        </h1>
      </header>

      <aside class="author-atlas-hero__aside" aria-label={t("作者档案")}>
        <figure class="author-portrait">
          {SITE_AUTHOR_PROFILE.avatar ? (
            <img
              class="author-avatar"
              src={SITE_AUTHOR_PROFILE.avatar}
              alt={SITE_AUTHOR_PROFILE.name + t(" 的头像")}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          ) : null}
          <figcaption>
            <span>{SITE_AUTHOR_PROFILE.name}</span>
            <span class="author-portrait__index" aria-hidden="true">FIG. 01</span>
          </figcaption>
        </figure>
        <div class="discover-hero__panel-stats author-atlas-hero__stats" aria-label={t("公开内容概览")}>
          <div class="discover-hero__panel-stat"><strong>{String(authorPublications.length).padStart(2, "0")}</strong><span>{t("已发表 / 已接收")}</span></div>
          <div class="discover-hero__panel-stat"><strong>{String(authorPosts.length).padStart(2, "0")}</strong><span>{t("公开文章")}</span></div>
          <div class="discover-hero__panel-stat"><strong>{String(topicCount).padStart(2, "0")}</strong><span>{t("内容主题")}</span></div>
          <div class="discover-hero__panel-stat"><strong>{String(SITE_AUTHOR_PROFILE.researchTracks?.length ?? 0).padStart(2, "0")}</strong><span>{t("研究轨道")}</span></div>
        </div>
      </aside>

      <div class="author-atlas-hero__main">
        {SITE_AUTHOR_PROFILE.tagline ? <p class="author-atlas-idcard__title">{SITE_AUTHOR_PROFILE.tagline}</p> : null}
        <h2 class="author-atlas-hero__statement">
          {t("在模型行为与真实系统之间，")}
          <em>{t("寻找可验证的答案。")}</em>
        </h2>
        {selectedPapers[0] ? (
          <div class="author-atlas-featured">
            <p class="author-atlas-featured__label">
              <span>{t("SELECTED WORK / 代表作")}</span>
              <span>{selectedPapers[0].data.venue?.short ?? selectedPapers[0].data.venue?.name} · {selectedPapers[0].data.year}</span>
            </p>
            <h3><a href={l("/papers/" + selectedPapers[0].id)}>{selectedPapers[0].data.title}<span aria-hidden="true">↗</span></a></h3>
          </div>
        ) : null}
        {SITE_AUTHOR_PROFILE.mission ? <p class="author-atlas-idcard__mission">{SITE_AUTHOR_PROFILE.mission}</p> : null}
        <p class="author-atlas-hero__intro">{SITE_AUTHOR_PROFILE.intro}</p>
        <nav class="author-atlas-hero__actions" aria-label={t("探索作者研究和内容")}>
          <a href={l("/papers")}>{t("研究成果")} <span aria-hidden="true">↗</span></a>
          <a href={l("/topics")}>{t("探索主题")} <span aria-hidden="true">↗</span></a>
          <a
            href={l("https://github.com/" + (SITE_AUTHOR_PROFILE.socials?.github ?? "yuki-zik"))}
            target="_blank"
            rel="noopener noreferrer"
          >GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </section>

    <div class="author-atlas-section-nav" aria-label={t("档案目录")}>
      <span>{t("INDEX / 阅读档案")}</span>
      <nav>
        <a href={l("#research")}>{t("研究方向")}</a>
        <a href={l("#publications")}>{t("论文")}</a>
        <a href={l("#practice")}>{t("项目")}</a>
        <a href={l("#writing")}>{t("写作")}</a>
      </nav>
    </div>

    <section class="discover-section author-atlas-research" id="research">
      <SectionHead
        kicker="Research"
        title={t("研究方向")}
        countLabel={`${SITE_AUTHOR_PROFILE.researchTracks?.length ?? 0} tracks`}
      />
      <div class="discover-entity-grid" data-editorial-grid="lead" data-ux-stagger>
        {SITE_AUTHOR_PROFILE.researchTracks?.map((track, index) => (
          <article class="discover-surface discover-entity-card" data-ux-reveal="fade-up">
            <div class="author-atlas-track__body">
              <div class="discover-entity-card__top" aria-hidden="true">
                <span class="author-atlas-track__index">{String(index + 1).padStart(2, "0")}</span>
                <span class="discover-entity-card__meta">TRACK</span>
              </div>
              <div class="author-atlas-track__copy">
                <h3>{track.title}</h3>
                <p>{track.summary}</p>
              </div>
              <ul class="pill-list">
                {track.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </div>
            {researchFigures[index] && (
              <EditorialFigure
                figure={researchFigures[index]}
                class="author-atlas-track__figure"
                sizes="(max-width: 600px) calc(100vw - 48px), (max-width: 1100px) 40vw, 520px"
              />
            )}
          </article>
        ))}
      </div>
    </section>

    <section class:list={["discover-section", "author-atlas-publications", { "author-atlas-publications--illustrated": selectedPapers.some(paper => paper.data.cover) }]} id="publications">
      <SectionHead
        kicker="Selected Publications"
        title={t("论文与研究成果")}
        description={t("已发表与已接收的论文，及其问题、方法与实验记录。")}
        countLabel={String(selectedPapers.length).padStart(2, "0") + " papers"}
      />
      <div class="author-atlas-publications__list" data-ux-stagger>
        {selectedPapers.map((paper, index) => (
          <article class="author-atlas-publication" data-ux-reveal="fade-up">
            <div class="author-atlas-publication__index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
              <span>{paper.data.year}</span>
            </div>
            <div class="author-atlas-publication__content">
              <p class="author-atlas-publication__venue">
                {paper.data.venue?.short ?? paper.data.venue?.name ?? "Research"}
                <span aria-hidden="true"> / </span>
                {paper.data.status === "published" ? t("已发表") : t("已接收")}
              </p>
              <h3><a href={l("/papers/" + paper.id)}>{paper.data.title}</a></h3>
              {paper.data.cover ? (
                <div class="publication-illustrated-overview">
                  <div class="publication-illustrated-overview__copy">
                    {paper.data.subtitle && <p class="publication-illustrated-overview__lede">{paper.data.subtitle}</p>}
                    <p>{paper.data.summary ?? paper.data.abstract}</p>
                  </div>
                  <PaperFigure cover={paper.data.cover} sizes="(max-width: 1050px) calc(100vw - 100px), 640px" />
                </div>
              ) : <p>{paper.data.summary ?? paper.data.abstract}</p>}
            </div>
            <a class="author-atlas-publication__link" href={l("/papers/" + paper.id)} aria-label={t("阅读论文 ") + paper.data.title}>↗</a>
          </article>
        ))}
      </div>
      <a class="author-atlas-text-link" href={l("/papers")}>{t("查看全部论文与研究记录")} <span aria-hidden="true">→</span></a>
    </section>

    <section class="discover-section author-atlas-practice" id="practice">
      <SectionHead
        kicker="Practice"
        title={t("项目 / 实践")}
        description={t("从实验框架、行为控制，到内容系统与工作流。")}
        countLabel={`${SITE_AUTHOR_PROFILE.practiceHighlights?.length ?? 0} items`}
      />
      <div class="discover-stream-list" data-editorial-grid="paired" data-ux-stagger>
        {SITE_AUTHOR_PROFILE.practiceHighlights?.map((item, index) => (
          <ContentDossier
            class="discover-stream-item author-practice-dossier"
            index={String(index + 1).padStart(2, "0")}
            label={item.label ?? t("PRACTICE / 项目实践")}
            title={item.title}
            description={item.description}
            descriptionClass="discover-stream-item__summary"
            variant="feature"
            detailsLabel={t("相关内容")}
            data-practice-dossier
          >
            {item.related?.length ? <Fragment slot="details">
              {item.related.map(link => <a href={l(link.href)}>{link.title}<span aria-hidden="true"> ↗</span></a>)}
            </Fragment> : null}
          </ContentDossier>
        ))}
      </div>
    </section>

    <section class="discover-section author-atlas-focus">
      <SectionHead
        kicker="Lens"
        title={t("当前关注与博客定位")}
      />
      <div class="discover-mini-grid" data-editorial-grid="paired" data-ux-stagger>
        <ContentDossier
          class="discover-mini-card author-focus-dossier"
          index="A"
          label={t("OPEN QUESTIONS / 研究问题")}
          title={t("当前关注")}
          items={SITE_AUTHOR_PROFILE.currentFocus}
          variant="note"
        >
          <a slot="footer" href={l("/papers")}>{t("沿研究成果继续阅读")} <span aria-hidden="true">↗</span></a>
        </ContentDossier>
        <ContentDossier
          class="discover-mini-card author-focus-dossier"
          index="B"
          label={t("FIELDNOTES / 写作范围")}
          title={t("本博客记录什么")}
          items={SITE_AUTHOR_PROFILE.blogScope}
          variant="note"
        >
          <a slot="footer" href={l("/topics")}>{t("沿主题寻找笔记")} <span aria-hidden="true">↗</span></a>
        </ContentDossier>
      </div>
    </section>

    {
      socialNetworks.length ? (
        <section class="discover-section author-atlas-socials" data-controller="social-stats">
          <SectionHead
            kicker="Social"
            title={t("社交媒体")}
            description={t("你也可以在这些平台继续找到我；支持的平台会实时刷新公开统计。")}
            countLabel={`${socialNetworks.length} platforms`}
          />

          <div class="author-social-grid" data-ux-stagger>
            {socialNetworks.map((network) => (
              <a
                class:list={[
                  "author-social-card",
                  "discover-surface",
                  `author-social-card--${network.id}`,
                  "grid grid-cols-[auto_minmax(0,1fr)_auto] min-h-[5.6rem] items-center gap-[0.85rem] px-[1.05rem] py-4"
                ]}
                href={l(network.href)}
                target="_blank"
                rel="noreferrer noopener"
                data-ux-reveal="fade-up"
                data-substats-source={network.substats?.source}
                data-substats-key={network.substats?.key}
              >
                <span
                  class="author-social-symbol inline-flex min-h-10 min-w-10 items-center justify-center rounded-[2px] px-2 py-[0.2rem] font-display text-[0.9rem] font-bold tracking-[0.04em]"
                  aria-hidden="true"
                >
                  {network.id === "telegram"
                    ? "TG"
                    : network.id === "github"
                      ? "GH"
                      : network.id === "zhihu"
                        ? t("知")
                        : t("红")}
                </span>

                <span class="author-social-copy grid min-w-0 gap-[0.18rem]">
                  <span class="author-social-name font-display text-[1.125rem] font-semibold tracking-[-0.02em]">{network.label}</span>
                  {network.description ? (
                    <span class="author-social-description text-[0.9375rem] leading-[1.55]">{network.description}</span>
                  ) : null}
                </span>

                <span class="author-social-stat grid justify-items-end gap-[0.08rem] text-right">
                  <strong class="font-display text-[clamp(1.2rem,1.4vw,1.6rem)] leading-none" data-social-count>
                    {network.statValue !== undefined ? network.statValue : network.statValueFallback ?? "--"}
                  </strong>
                  {network.statLabel ? (
                    <span class="text-sm" data-social-label>
                      {network.statLabel}
                    </span>
                  ) : null}
                </span>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }

    <section class="discover-section author-atlas-contacts">
      <SectionHead
        kicker="Contact"
        title={t("联系方式 / 外链")}
        description={t("学术资料、开源代码与联系邮箱。")}
      />
      <div class="discover-mini-grid" data-ux-stagger>
        {authorContactEntries.map((entry) => (
          <a
            class="discover-surface discover-mini-card"
            href={l(entry.href)}
            target={entry.external ? "_blank" : undefined}
            rel={entry.external ? "noreferrer noopener" : undefined}
            data-ux-reveal="fade-up"
          >
            <span class="discover-mini-card__meta">{entry.label}</span>
            <h3>{entry.value}</h3>
          </a>
        ))}
      </div>
    </section>

    <section class="discover-section author-posts author-atlas-writing" id="writing">
      <SectionHead
        kicker="Writing"
        title={t("作者文章")}
        description={t("以下是当前博客中已发布、由 {0} 署名的文章。", [SITE_AUTHOR_PROFILE.name])}
        countLabel={`${authorPosts.length} posts`}
      />
      {
        authorPosts.length === 0 ? (
          <EmptyState title={t("暂时还没有可展示的文章。")} body={t("等第一批内容发布后，这里会自动接入统一的文章卡片列表。")} />
        ) : (
          <div class="discover-post-grid author-post-grid mt-[0.2rem]" data-editorial-grid="paired" data-ux-stagger>
            {authorPosts.map((post) => <PostCard post={post} />)}
          </div>
        )
      }
    </section>
  </DiscoverShell>
  <ImageViewer />
</BaseLayout>
