---
import { getCollection } from "astro:content";
import DiscoverShell from "../components/discover/DiscoverShell.astro";
import EmptyState from "../components/discover/EmptyState.astro";
import PageHero from "../components/discover/PageHero.astro";
import SectionHead from "../components/discover/SectionHead.astro";
import PostCard from "../components/post/PostCard.astro";
import { SITE_AUTHOR_PROFILE } from "../lib/site";
import { resolvePostAuthor } from "../lib/posts/author";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft);

const authorPosts = [...posts]
  .filter((post) => resolvePostAuthor(post).name === SITE_AUTHOR_PROFILE.name)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const latestAuthorPost = authorPosts[0] ?? null;
const topicCount = new Set(authorPosts.flatMap((post) => post.data.topics)).size;
const socialNetworks = SITE_AUTHOR_PROFILE.socialNetworks ?? [];

const heroSecondaryAction = SITE_AUTHOR_PROFILE.socials?.github
  ? {
      href: `https://github.com/${SITE_AUTHOR_PROFILE.socials.github}`,
      label: "查看 GitHub",
      variant: "secondary" as const,
      external: true,
      icon: "network" as const
    }
  : SITE_AUTHOR_PROFILE.email
    ? {
        href: `mailto:${SITE_AUTHOR_PROFILE.email}`,
        label: "Email",
        variant: "secondary" as const,
        icon: "mail" as const
      }
    : {
        href: "/archives",
        label: "浏览归档",
        variant: "secondary" as const,
        icon: "archive" as const
      };

const authorContactEntries = [
  SITE_AUTHOR_PROFILE.email
    ? {
        label: "Email",
        value: SITE_AUTHOR_PROFILE.email,
        href: `mailto:${SITE_AUTHOR_PROFILE.email}`
      }
    : null,
  SITE_AUTHOR_PROFILE.socials?.github
    ? {
        label: "GitHub",
        value: `github.com/${SITE_AUTHOR_PROFILE.socials.github}`,
        href: `https://github.com/${SITE_AUTHOR_PROFILE.socials.github}`,
        external: true
      }
    : null,
  {
    label: "Google Scholar",
    value: "scholar.google.com/citations?user=NTwrnCIAAAAJ&hl=zh-CN",
    href: "https://scholar.google.com/citations?user=NTwrnCIAAAAJ&hl=zh-CN",
    external: true
  }
].filter(
  (
    entry
  ): entry is {
    label: string;
    value: string;
    href: string;
    external?: boolean;
  } => entry !== null
);
---

<BaseLayout
  title={`${SITE_AUTHOR_PROFILE.name} | 作者`}
  description={SITE_AUTHOR_PROFILE.intro ?? SITE_AUTHOR_PROFILE.bioShort}
  authorMeta={SITE_AUTHOR_PROFILE.name}
  runtime="discover"
>
  <DiscoverShell>
    <PageHero
      variant="split"
      kicker="About / Author"
      title={SITE_AUTHOR_PROFILE.name}
      description={SITE_AUTHOR_PROFILE.intro ?? SITE_AUTHOR_PROFILE.bioShort}
      actions={[
        latestAuthorPost
          ? {
              href: `/posts/${latestAuthorPost.slug}`,
              label: `阅读《${latestAuthorPost.data.title}》`,
              variant: "primary",
              icon: "arrow"
            }
          : {
              href: "/archives",
              label: "翻阅归档",
              variant: "primary",
              icon: "archive"
            },
        heroSecondaryAction
      ]}
    >
      <div slot="aside">
        <div class="discover-hero__panel-copy">
          <p class="discover-hero__panel-label">Mission</p>
          {SITE_AUTHOR_PROFILE.avatar ? (
            <img
              class="author-avatar aspect-square w-[clamp(5.5rem,9vw,7rem)] rounded-[18px] object-cover"
              src={SITE_AUTHOR_PROFILE.avatar}
              alt={`${SITE_AUTHOR_PROFILE.name} 的头像`}
              loading="eager"
              decoding="async"
            />
          ) : null}
          {SITE_AUTHOR_PROFILE.tagline ? <p>{SITE_AUTHOR_PROFILE.tagline}</p> : null}
          {SITE_AUTHOR_PROFILE.mission ? <p>{SITE_AUTHOR_PROFILE.mission}</p> : null}
        </div>
        <div class="discover-hero__panel-stats">
          <div class="discover-hero__panel-stat">
            <strong>{String(authorPosts.length).padStart(2, "0")}</strong>
            <span>篇文章</span>
          </div>
          <div class="discover-hero__panel-stat">
            <strong>{String(topicCount).padStart(2, "0")}</strong>
            <span>个主题</span>
          </div>
          <div class="discover-hero__panel-stat">
            <strong>{String(SITE_AUTHOR_PROFILE.researchTracks?.length ?? 0).padStart(2, "0")}</strong>
            <span>研究轨道</span>
          </div>
          <div class="discover-hero__panel-stat">
            <strong>{String(socialNetworks.length).padStart(2, "0")}</strong>
            <span>社交入口</span>
          </div>
        </div>
      </div>
    </PageHero>

    <section class="discover-section">
      <SectionHead
        kicker="Research"
        title="研究 / 技术方向"
        description="围绕系统能力、行为控制与工程化闭环展开，而不是把模型能力停留在单点演示。"
        countLabel={`${SITE_AUTHOR_PROFILE.researchTracks?.length ?? 0} tracks`}
      />
      <div class="discover-entity-grid" data-ux-stagger>
        {SITE_AUTHOR_PROFILE.researchTracks?.map((track) => (
          <article class="discover-surface discover-entity-card" data-ux-reveal="fade-up">
            <div class="discover-entity-card__top">
              <span class="discover-entity-card__meta">Research Track</span>
            </div>
            <h3>{track.title}</h3>
            <p>{track.summary}</p>
            <ul class="pill-list">
              {track.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="discover-section">
      <SectionHead
        kicker="Practice"
        title="项目 / 实践"
        description="只保留能体现方法与落地能力的实践，不写空泛的能力陈述。"
        countLabel={`${SITE_AUTHOR_PROFILE.practiceHighlights?.length ?? 0} items`}
      />
      <div class="discover-stream-list" data-ux-stagger>
        {SITE_AUTHOR_PROFILE.practiceHighlights?.map((item, index) => (
          <article class="discover-surface discover-stream-item" data-ux-reveal="fade-up">
            <span class="discover-stream-item__eyebrow">Practice {String(index + 1).padStart(2, "0")}</span>
            <div class="discover-stream-item__row">
              <h3 class="discover-stream-item__title">{item.title}</h3>
            </div>
            <p class="discover-stream-item__summary">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="discover-section">
      <SectionHead
        kicker="Lens"
        title="当前关注与博客定位"
        description="研究问题、工程方法和写作范围保持同一条主线，避免作者页与博客内容脱节。"
      />
      <div class="discover-mini-grid" data-ux-stagger>
        <article class="discover-surface discover-mini-card" data-ux-reveal="fade-up">
          <span class="discover-mini-card__meta">Current Focus</span>
          <h3>当前关注</h3>
          <ul class="pill-list">
            {SITE_AUTHOR_PROFILE.currentFocus?.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="discover-surface discover-mini-card" data-ux-reveal="fade-up">
          <span class="discover-mini-card__meta">Blog Scope</span>
          <h3>本博客记录什么</h3>
          <ul class="pill-list">
            {SITE_AUTHOR_PROFILE.blogScope?.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </section>

    {
      socialNetworks.length ? (
        <section class="discover-section" data-controller="social-stats">
          <SectionHead
            kicker="Social"
            title="社交媒体"
            description="你也可以在这些平台继续找到我；支持的平台会实时刷新公开统计。"
            countLabel={`${socialNetworks.length} platforms`}
          />

          <div class="author-social-grid" data-ux-stagger>
            {socialNetworks.map((network) => (
              <a
                class:list={[
                  "author-social-card",
                  "discover-surface",
                  `author-social-card--${network.id}`,
                  "grid grid-cols-[auto_minmax(0,1fr)_auto] min-h-[5.6rem] items-center gap-[0.85rem] px-[1.05rem] py-4"
                ]}
                href={network.href}
                target="_blank"
                rel="noreferrer noopener"
                data-ux-reveal="fade-up"
                data-substats-source={network.substats?.source}
                data-substats-key={network.substats?.key}
              >
                <span
                  class="author-social-symbol inline-flex min-h-10 min-w-10 items-center justify-center rounded-[14px] px-2 py-[0.2rem] font-display text-[0.9rem] font-bold tracking-[0.04em]"
                  aria-hidden="true"
                >
                  {network.id === "telegram"
                    ? "TG"
                    : network.id === "github"
                      ? "GH"
                      : network.id === "zhihu"
                        ? "知"
                        : "红"}
                </span>

                <span class="author-social-copy grid min-w-0 gap-[0.18rem]">
                  <span class="author-social-name font-display text-[1rem] font-semibold tracking-[-0.02em]">{network.label}</span>
                  {network.description ? (
                    <span class="author-social-description text-[0.82rem] leading-[1.55]">{network.description}</span>
                  ) : null}
                </span>

                <span class="author-social-stat grid justify-items-end gap-[0.08rem] text-right">
                  <strong class="font-display text-[clamp(1.2rem,1.4vw,1.6rem)] leading-none" data-social-count>
                    {network.statValue !== undefined ? network.statValue : network.statValueFallback ?? "--"}
                  </strong>
                  {network.statLabel ? (
                    <span class="text-[0.82rem]" data-social-label>
                      {network.statLabel}
                    </span>
                  ) : null}
                </span>
              </a>
            ))}
          </div>
        </section>
      ) : null
    }

    <section class="discover-section">
      <SectionHead
        kicker="Contact"
        title="联系方式 / 外链"
        description="保持最少但明确的公共入口；后续若补充学术或社交渠道，也会沿用同一结构。"
      />
      <div class="discover-mini-grid" data-ux-stagger>
        {authorContactEntries.map((entry) => (
          <a
            class="discover-surface discover-mini-card"
            href={entry.href}
            target={entry.external ? "_blank" : undefined}
            rel={entry.external ? "noreferrer noopener" : undefined}
            data-ux-reveal="fade-up"
          >
            <span class="discover-mini-card__meta">{entry.label}</span>
            <h3>{entry.value}</h3>
            <p>保持一个干净、稳定的公共联系入口。</p>
          </a>
        ))}
      </div>
    </section>

    <section class="discover-section author-posts">
      <SectionHead
        kicker="Writing"
        title="作者文章"
        description={`以下是当前博客中已发布、由 ${SITE_AUTHOR_PROFILE.name} 署名的文章。`}
        countLabel={`${authorPosts.length} posts`}
      />
      {
        authorPosts.length === 0 ? (
          <EmptyState title="暂时还没有可展示的文章。" body="等第一批内容发布后，这里会自动接入统一的文章卡片列表。" />
        ) : (
          <div class="discover-post-grid author-post-grid mt-[0.2rem]" data-ux-stagger>
            {authorPosts.map((post) => <PostCard post={post} />)}
          </div>
        )
      }
    </section>
  </DiscoverShell>
</BaseLayout>
