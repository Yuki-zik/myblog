---
import { getCollection, type CollectionEntry } from "astro:content";
import PostCover from "./PostCover.astro";
import MetaIcon from "../ui/MetaIcon.astro";
import { formatPostDisplayDate } from "../../lib/posts/date";
import { getPostReadingMinutes } from "../../lib/posts/readingTime";

interface Props {
  post: CollectionEntry<"posts">;
}

type MetaItem = {
  icon: "calendar" | "refresh" | "article";
  label: string;
  ariaLabel: string;
};

type StatItem = {
  icon: "clock" | "tag" | "nodes";
  label: string;
  ariaLabel: string;
};

const { post } = Astro.props;
const topics = await getCollection("topics");
const topicTitleBySlug = new Map(topics.map((topic) => [topic.id, topic.data.title]));
const publishedLabel = formatPostDisplayDate(post.data.date);
const updatedLabel = post.data.updated ? formatPostDisplayDate(post.data.updated) : null;
const readingMinutes = getPostReadingMinutes(post);
const readingTimeLabel = readingMinutes <= 1 ? "1 分钟阅读" : `${readingMinutes} 分钟阅读`;
const topicCountLabel = `${post.data.topics.length} 个主题`;
const conceptCountLabel = (post.data.concepts?.length ?? 0) > 0 ? `${post.data.concepts!.length} 个概念` : null;
const metaItems = [
  {
    icon: "calendar" as const,
    label: publishedLabel,
    ariaLabel: `发布日期 ${publishedLabel}`
  },
  updatedLabel
    ? {
        icon: "refresh" as const,
        label: updatedLabel,
        ariaLabel: `更新日期 ${updatedLabel}`
      }
    : null,
  {
    icon: "article" as const,
    label: "文章",
    ariaLabel: "文章类型"
  }
] as Array<MetaItem | null>;
const statItems = [
  {
    icon: "clock" as const,
    label: readingTimeLabel,
    ariaLabel: `预计阅读时间 ${readingTimeLabel}`
  },
  {
    icon: "tag" as const,
    label: topicCountLabel,
    ariaLabel: topicCountLabel
  },
  conceptCountLabel
    ? {
        icon: "nodes" as const,
        label: conceptCountLabel,
        ariaLabel: conceptCountLabel
      }
    : null
] as Array<StatItem | null>;
---

<article class="post-card grid min-h-full gap-0 overflow-visible" data-post-card data-ux-reveal="fade-up">
  <a href={`/posts/${post.id}`} class="post-card-cover-link block" aria-label={`阅读文章：${post.data.title}`}>
    <PostCover post={post} variant="card" />
  </a>

  <div class="post-card-body grid">
    <p class="post-card-meta-row subtle flex flex-wrap items-center gap-x-[0.72rem] gap-y-[0.36rem]" aria-label="文章元信息">
      {(metaItems.filter(Boolean) as MetaItem[]).map((item) => (
        <span class="post-card-meta-item inline-flex items-center gap-[0.34rem]" aria-label={item.ariaLabel}>
          <MetaIcon name={item.icon} class="post-card-meta-icon flex-none" />
          <span>{item.label}</span>
        </span>
      ))}
    </p>

    <h3 class="post-card-title">
      <a href={`/posts/${post.id}`}>{post.data.title}</a>
    </h3>

    {post.data.summary ? <p class="post-card-summary max-w-[58ch] text-base leading-[1.78]">{post.data.summary}</p> : null}

    <div class="post-card-stats-row flex items-center justify-between gap-[0.8rem] pt-[0.08rem]" aria-label="文章辅助信息">
      <div class="post-card-stats flex flex-wrap gap-x-[0.72rem] gap-y-[0.42rem]">
        {(statItems.filter(Boolean) as StatItem[]).map((item) => (
          <span class="post-card-stat inline-flex items-center gap-[0.34rem]" aria-label={item.ariaLabel}>
            <MetaIcon name={item.icon} class="post-card-stat-icon flex-none" />
            <span>{item.label}</span>
          </span>
        ))}
      </div>
      <span class="post-card-more flex-none whitespace-nowrap text-[0.82rem] font-semibold tracking-[0.01em]">阅读全文</span>
    </div>

    <ul class="pill-list post-card-topics flex-auto" aria-label="文章主题标签">
      {post.data.topics.map((topicSlug) => (
        <li><a href={`/topics/${topicSlug}`}>#{topicTitleBySlug.get(topicSlug) ?? topicSlug}</a></li>
      ))}
    </ul>

    <div class="post-card-endmark mt-[0.62rem] h-px w-[min(7.4rem,26%)]" aria-hidden="true"></div>
  </div>
</article>
