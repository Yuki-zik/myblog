---
import { getLocale, createTranslator, localizePath } from "../../lib/i18n/index";
import { collectionReader } from "../../lib/i18n/content";
const locale = getLocale(Astro.url.pathname);
const t = createTranslator(locale);
const l = (value: string | undefined) => localizePath(value, locale);
const getCollection = collectionReader(locale);

import { getCollection as rawGetCollection, type CollectionEntry } from "astro:content";
import PostCover from "./PostCover.astro";
import "../../styles/editorial-posts.css";
import MetaIcon from "../ui/MetaIcon.astro";
import { formatPostDisplayDate } from "../../lib/posts/date";
import { getPostReadingMinutes } from "../../lib/posts/readingTime";

interface Props {
  post: CollectionEntry<"posts">;
  compactMetadata?: boolean;
}

type MetaItem = {
  icon: "calendar" | "refresh" | "article";
  label: string;
  ariaLabel: string;
};

type StatItem = {
  icon: "clock" | "tag" | "nodes";
  label: string;
  ariaLabel: string;
};

const { post, compactMetadata = false } = Astro.props;
const topics = await getCollection("topics");
const topicTitleBySlug = new Map(topics.map((topic) => [topic.id, topic.data.title]));
const publishedLabel = formatPostDisplayDate(post.data.date);
const updatedLabel = post.data.updated ? formatPostDisplayDate(post.data.updated) : null;
const readingMinutes = getPostReadingMinutes(post);
const readingTimeLabel = readingMinutes <= 1 ? t("1 分钟阅读") : t("{0} 分钟阅读", [readingMinutes]);
const topicCountLabel = t("{0} 个主题", [post.data.topics.length]);
const conceptCountLabel = (post.data.concepts?.length ?? 0) > 0 ? t("{0} 个概念", [post.data.concepts!.length]) : null;
const metaItems = [
  {
    icon: "calendar" as const,
    label: publishedLabel,
    ariaLabel: t("发布日期 {0}", [publishedLabel])
  },
  updatedLabel
    ? {
        icon: "refresh" as const,
        label: updatedLabel,
        ariaLabel: t("更新日期 {0}", [updatedLabel])
      }
    : null,
  compactMetadata ? null : {
    icon: "article" as const,
    label: t("文章"),
    ariaLabel: t("文章类型")
  }
] as Array<MetaItem | null>;
const statItems = [
  {
    icon: "clock" as const,
    label: readingTimeLabel,
    ariaLabel: t("预计阅读时间 {0}", [readingTimeLabel])
  },
  compactMetadata ? null : {
    icon: "tag" as const,
    label: topicCountLabel,
    ariaLabel: topicCountLabel
  },
  conceptCountLabel && !compactMetadata
    ? {
        icon: "nodes" as const,
        label: conceptCountLabel,
        ariaLabel: conceptCountLabel
      }
    : null
] as Array<StatItem | null>;
---

<article class="post-card grid min-h-full gap-0 overflow-visible" data-post-card data-ux-reveal="fade-up">
  <a href={l(`/posts/${post.id}`)} class="post-card-cover-link block" aria-label={t("阅读文章：{0}", [post.data.title])}>
    <PostCover post={post} variant="card" />
  </a>

  <div class="post-card-body grid">
    <p class="post-card-meta-row subtle flex flex-wrap items-center gap-x-[0.72rem] gap-y-[0.36rem]" role="group" aria-label={t("文章元信息")}>
      {(metaItems.filter(Boolean) as MetaItem[]).map((item) => (
        <span class="post-card-meta-item inline-flex items-center gap-[0.34rem]">
          <MetaIcon name={item.icon} class="post-card-meta-icon flex-none" />
          <span class="sr-only">{item.ariaLabel}</span>
          <span aria-hidden="true">{item.label}</span>
        </span>
      ))}
    </p>

    <h3 class="post-card-title">
      <a href={l(`/posts/${post.id}`)}>{post.data.title}</a>
    </h3>

    {post.data.summary ? <p class="post-card-summary max-w-[58ch] text-base leading-[1.78]">{post.data.summary}</p> : null}

    <div class="post-card-stats-row flex items-center justify-between gap-[0.8rem] pt-[0.08rem]" role="group" aria-label={t("文章辅助信息")}>
      <div class="post-card-stats flex flex-wrap gap-x-[0.72rem] gap-y-[0.42rem]">
        {(statItems.filter(Boolean) as StatItem[]).map((item) => (
          <span class="post-card-stat inline-flex items-center gap-[0.34rem]">
            <MetaIcon name={item.icon} class="post-card-stat-icon flex-none" />
            <span class="sr-only">{item.ariaLabel}</span>
            <span aria-hidden="true">{item.label}</span>
          </span>
        ))}
      </div>
      <span class="post-card-more flex-none whitespace-nowrap text-[0.82rem] font-semibold tracking-[0.01em]">{t("阅读全文")}</span>
    </div>

    <ul class="pill-list post-card-topics flex-auto" aria-label={t("文章主题标签")}>
      {post.data.topics.map((topicSlug: string) => (
        <li><a href={l(`/topics/${topicSlug}`)}>#{topicTitleBySlug.get(topicSlug) ?? topicSlug}</a></li>
      ))}
    </ul>

    <div class="post-card-endmark mt-[0.62rem] h-px w-[min(7.4rem,26%)]" aria-hidden="true"></div>
  </div>
</article>
