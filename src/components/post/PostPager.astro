---
import { getLocale, createTranslator, localizePath } from "../../lib/i18n/index";
const locale = getLocale(Astro.url.pathname);
const t = createTranslator(locale);
const l = (value: string | undefined) => localizePath(value, locale);

import type { CollectionEntry } from "astro:content";
import { formatPostDisplayDate } from "../../lib/posts/date";

interface Props {
  newerPost: CollectionEntry<"posts"> | null;
  olderPost: CollectionEntry<"posts"> | null;
}

const { newerPost, olderPost } = Astro.props;
const pagerPosts = [
  newerPost
    ? {
        post: newerPost,
        label: t("较新文章")
      }
    : null,
  olderPost
    ? {
        post: olderPost,
        label: t("更早文章")
      }
    : null
].filter(Boolean) as Array<{
  post: CollectionEntry<"posts">;
  label: string;
}>;
---

{
  pagerPosts.length > 0 ? (
    <nav class="post-pager" aria-label={t("继续阅读")}>
      {pagerPosts.map(({ post, label }) => (
        <a class="post-pager-link" href={l(`/posts/${post.id}`)}>
          <span class="post-pager-label">{label}</span>
          <strong class="post-pager-title">{post.data.title}</strong>
          <span class="post-pager-meta">
            {formatPostDisplayDate(post.data.date)}
            {post.data.summary ? ` · ${post.data.summary}` : ""}
          </span>
        </a>
      ))}
    </nav>
  ) : null
}
