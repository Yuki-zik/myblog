---
import type { CollectionEntry } from "astro:content";
import ContentDossier from "../discover/ContentDossier.astro";
import PostCover from "./PostCover.astro";
import "../../styles/archive-dossiers.css";

interface Props {
  post: CollectionEntry<"posts">;
  author: string;
  dateLabel: string;
}

const { post, author, dateLabel } = Astro.props;
---

<article class="archive-post-tile overflow-visible" data-archive-card data-ux-reveal="fade-up">
  <ContentDossier
    class="archive-post-dossier"
    label="READING NOTE / 文章"
    title={post.data.title}
    description={post.data.summary}
    href={`/posts/${post.id}`}
    variant="compact"
    copyClass="archive-post-content"
    descriptionClass="archive-post-summary"
  >
    <p slot="meta" class="archive-post-meta">
      <time datetime={post.data.date} data-archive-date>{dateLabel}</time>
      <span data-archive-author>By {author}</span>
    </p>
    <a
      slot="media"
      href={`/posts/${post.id}`}
      class="archive-post-link archive-post-media"
      aria-label={`Read post: ${post.data.title}, ${dateLabel} By ${author}`}
    >
      <PostCover post={post} variant="poster" />
    </a>
    <a slot="footer" href={`/posts/${post.id}`} class="archive-post-kicker">阅读文章</a>
  </ContentDossier>
</article>
