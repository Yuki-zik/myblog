---
import { SITE_AUTHOR_PROFILE } from "../../lib/site";

type HomeFooterLink = {
  href: string;
  label: string;
  kind: "github" | "mail" | "telegram" | "zhihu" | "xiaohongshu";
};

interface Props {
  variant?: "full-bleed" | "discover" | "reading";
}

const year = new Date().getFullYear();
const footerNote = SITE_AUTHOR_PROFILE.bioShort ?? "AI / 技术 / 知识网络";
const footerQuote =
  SITE_AUTHOR_PROFILE.mission ?? "把研究、工程和写作组织成可执行、可复用、可持续迭代的系统。";
const { variant = "full-bleed" } = Astro.props;

const socialNetworkById = new Map(
  (SITE_AUTHOR_PROFILE.socialNetworks ?? []).map((network) => [network.id, network])
);

const footerLinks = [
  SITE_AUTHOR_PROFILE.socials?.github
    ? {
        href: `https://github.com/${SITE_AUTHOR_PROFILE.socials.github}`,
        label: "GitHub",
        kind: "github"
      }
    : null,
  SITE_AUTHOR_PROFILE.email
    ? {
        href: `mailto:${SITE_AUTHOR_PROFILE.email}`,
        label: "Email",
        kind: "mail"
      }
    : null,
  socialNetworkById.get("telegram")
    ? {
        href: socialNetworkById.get("telegram")!.href,
        label: "Telegram",
        kind: "telegram"
      }
    : null,
  socialNetworkById.get("zhihu")
    ? {
        href: socialNetworkById.get("zhihu")!.href,
        label: "知乎",
        kind: "zhihu"
      }
    : socialNetworkById.get("xiaohongshu")
      ? {
          href: socialNetworkById.get("xiaohongshu")!.href,
          label: "小红书",
          kind: "xiaohongshu"
        }
      : null
] as Array<HomeFooterLink | null>;

const visibleLinks = footerLinks.filter(Boolean) as HomeFooterLink[];
---

<footer
  class:list={[
    "home-reference-footer",
    variant === "discover" && "home-reference-footer--compact",
    variant === "reading" && "home-reference-footer--reading"
  ]}
  data-home-reference-footer={variant === "full-bleed" ? true : undefined}
>
  <div class="home-reference-footer__grid mx-auto grid w-full max-w-[80rem] grid-cols-3 items-center gap-8 px-6 py-12">
    <div class="home-reference-footer__brand-block flex flex-col gap-2">
      <div class="home-reference-footer__brand-row flex items-center gap-2 font-(family-name:--hr-font-serif) font-medium">
        <span class="home-reference-footer__brand-mark grid h-6 w-6 place-items-center rounded-[0.25rem] font-(family-name:--hr-font-mono) text-[0.625rem] font-bold">MB</span>
        <span class="home-reference-footer__brand-name text-[1rem]">MyBlog</span>
      </div>
      <p class="home-reference-footer__note font-(family-name:--hr-font-mono) text-[0.75rem]">{SITE_AUTHOR_PROFILE.name} · {footerNote}</p>
      <p class="home-reference-footer__copy font-(family-name:--hr-font-mono) text-[0.75rem]">© {year} {SITE_AUTHOR_PROFILE.name}. All rights reserved.</p>
    </div>

    <div class="home-reference-footer__quote-block text-center">
      <p class="home-reference-footer__quote font-(family-name:--hr-font-serif) text-[0.875rem] leading-[1.7] italic">“{footerQuote}”</p>
    </div>

    <div class="home-reference-footer__socials flex items-center justify-end gap-4" aria-label="首页页脚社交链接">
      {
        visibleLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") || link.href.startsWith("mailto:") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer noopener" : undefined}
            class="home-reference-footer__social-link inline-flex h-10 w-10 items-center justify-center rounded-full"
            aria-label={link.label}
            title={link.label}
          >
            {link.kind === "github" ? (
              <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            ) : link.kind === "mail" ? (
              <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3.5" y="5.5" width="17" height="13" rx="2.5"></rect>
                <path d="m4.5 7 7.5 6 7.5-6"></path>
              </svg>
            ) : link.kind === "telegram" ? (
              <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.2 4.3 3.8 11.1c-1 .4-1 1.8.1 2.1l4.2 1.3 1.6 5.1c.3 1 1.6 1.2 2.2.4l2.4-3 4.7 3.4c.8.6 1.9.1 2.1-.9l2.2-13.8c.2-1-.8-1.8-1.8-1.4ZM9.3 13.8l8.9-5.9-6.9 6.9-.3 3.2-1.7-4.2Z" />
              </svg>
            ) : link.kind === "zhihu" ? (
              <span class="home-reference-footer__social-text font-(family-name:--hr-font-mono) text-[0.875rem] font-bold">知</span>
            ) : (
              <span class="home-reference-footer__social-text font-(family-name:--hr-font-mono) text-[0.875rem] font-bold">书</span>
            )}
          </a>
        ))
      }
    </div>
  </div>
</footer>
