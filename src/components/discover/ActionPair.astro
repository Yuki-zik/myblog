---
export type DiscoverAction = {
  href: string;
  label: string;
  variant?: "primary" | "secondary";
  external?: boolean;
  icon?: "arrow" | "network" | "mail" | "archive" | "topic";
};

interface Props {
  actions: DiscoverAction[];
  className?: string;
}

const { actions, className } = Astro.props;

function iconMarkup(icon: DiscoverAction["icon"]) {
  switch (icon) {
    case "network":
      return `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2"></circle><circle cx="18" cy="6" r="2"></circle><circle cx="12" cy="18" r="2"></circle><path d="M8 6h8"></path><path d="m7.7 7.1 3.2 8.1"></path><path d="m16.3 7.1-3.2 8.1"></path></svg>`;
    case "mail":
      return `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5.5" width="17" height="13" rx="2.5"></rect><path d="m4.5 7 7.5 6 7.5-6"></path></svg>`;
    case "archive":
      return `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7.5h16"></path><rect x="4" y="5" width="16" height="15" rx="2.5"></rect><path d="M9.5 11.5h5"></path></svg>`;
    case "topic":
      return `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5v14"></path><path d="M5 5h14v14H5z"></path></svg>`;
    case "arrow":
    default:
      return `<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>`;
  }
}
---

{
  actions.length > 0 ? (
    <div class:list={["discover-action-pair flex flex-wrap gap-4", className]}>
      {actions.map((action) => (
        <a
          href={action.href}
          class:list={[
            "discover-action inline-flex min-h-[3.125rem] items-center gap-2 rounded-full border border-solid border-transparent px-6 py-3 text-sm font-medium leading-none",
            `discover-action--${action.variant ?? "secondary"}`
          ]}
          target={action.external ? "_blank" : undefined}
          rel={action.external ? "noreferrer noopener" : undefined}
        >
          <span>{action.label}</span>
          <span class="discover-action__icon inline-flex items-center justify-center" set:html={iconMarkup(action.icon)} />
        </a>
      ))}
    </div>
  ) : null
}
