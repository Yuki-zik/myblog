---
import DiscoverAmbient from "./DiscoverAmbient.astro";

interface Props {
  bodyClass?: string;
}

const { bodyClass } = Astro.props;
---

<div class="discover-page relative min-h-screen" data-discover-page>
  <DiscoverAmbient />

  <div
    class:list={[
      "discover-page__body relative z-[1] mx-auto flex w-full max-w-[80rem] flex-col gap-20 px-6 pt-12 pb-0",
      bodyClass
    ]}
  >
    <slot />
  </div>
</div>
