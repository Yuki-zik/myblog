---
import ActionPair, { type DiscoverAction } from "./ActionPair.astro";

export type DiscoverHeroStat = {
  value: string;
  label: string;
};

interface Props {
  kicker: string;
  title: string;
  description?: string;
  actions?: DiscoverAction[];
  stats?: DiscoverHeroStat[];
  variant?: "poster" | "split" | "reading-header";
  className?: string;
}

const {
  kicker,
  title,
  description,
  actions = [],
  stats = [],
  variant = "poster",
  className
} = Astro.props;
---

<section
  class:list={[
    "discover-hero grid gap-8",
    `discover-hero--${variant}`,
    className
  ]}
  data-discover-hero
  data-ux-stagger
>
  <div class="discover-hero__copy flex flex-col gap-6" data-ux-reveal="fade-up">
    <p class="discover-hero__kicker text-[0.75rem] font-bold uppercase tracking-[0.22em]">{kicker}</p>
    <h1 class="discover-hero__title">{title}</h1>
    {description ? <p class="discover-hero__description max-w-[36rem] text-lg leading-[1.8]">{description}</p> : null}
    {actions.length > 0 ? <ActionPair actions={actions} /> : null}
    {
      stats.length > 0 ? (
        <ul
          class="discover-hero__stats grid max-w-[48rem] list-none grid-cols-[repeat(auto-fit,minmax(9rem,1fr))] gap-[0.9rem] p-0"
          aria-label="页面摘要"
        >
          {stats.map((stat) => (
            <li class="discover-hero__stat grid gap-[0.18rem] rounded-[1rem] px-4 py-[0.95rem]">
              <strong class="text-2xl font-semibold leading-none">{stat.value}</strong>
              <span class="text-[0.75rem]">{stat.label}</span>
            </li>
          ))}
        </ul>
      ) : null
    }
  </div>

  {
    variant === "split" ? (
      <aside class="discover-hero__panel discover-surface grid gap-4 p-[1.2rem]" data-ux-reveal="fade-up">
        <slot name="aside" />
      </aside>
    ) : null
  }
</section>
