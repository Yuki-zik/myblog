---
interface Props {
  kicker: string;
  title: string;
  description?: string;
  countLabel?: string;
  linkHref?: string;
  linkLabel?: string;
}

const {
  kicker,
  title,
  description,
  countLabel,
  linkHref,
  linkLabel
} = Astro.props;
---

<header class="discover-section-head" data-ux-reveal="fade-up">
  <div class="discover-section-head__copy">
    <p class="discover-section-head__kicker">{kicker}</p>
    <h2>{title}</h2>
    {description ? <p>{description}</p> : null}
  </div>

  <div class="discover-section-head__meta">
    {countLabel ? <span class="discover-section-head__count">{countLabel}</span> : null}
    {
      linkHref && linkLabel ? (
        <a href={linkHref} class="discover-section-head__link">
          <span>{linkLabel}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      ) : null
    }
  </div>
</header>
