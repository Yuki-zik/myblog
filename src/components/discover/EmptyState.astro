---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<div class="discover-empty discover-surface px-5 py-[1.2rem]">
  <p class="discover-empty__title text-[1.05rem] font-medium">{title}</p>
  <p class="discover-empty__body leading-[1.72]">{body}</p>
</div>
