---
import type { Coverage } from "../../../lib/agents/observatory";
import "../../../styles/agent-instruments.css";
interface Props { id?: string; value?: number | null; coverage?: Coverage; observedDays?: number; }
const { id = "agent-delivery", value = null, coverage = "none", observedDays = 0 } = Astro.props;
const formatted = value === null ? "待记录" : new Intl.NumberFormat("zh-CN", { maximumFractionDigits: 1 }).format(value);
const coverageLabel = value === null
  ? coverage === "partial" ? "记录待补全" : "个人实测"
  : coverage === "partial" ? "已记录 " + observedDays + "/7 天" : "最近 7 天";
const tickets = [
  { number: "01", category: "界面", title: "一处界面修正", criterion: "约定的页面在桌面和手机上均能正常使用。", evidence: "示意票据没有关联真实项目。实际验收需附页面、变更或检查记录。" },
  { number: "02", category: "研究", title: "一份资料摘记", criterion: "主要结论能回到原始来源，并明确适用范围。", evidence: "这里展示验收结构。真实交付应提供来源链接与可查阅的摘记。" },
  { number: "03", category: "文字", title: "一次文本整理", criterion: "事实与原稿一致，约定的修改已经逐项检查。", evidence: "此票仅供翻阅演示。实际成果应附最终稿或可检查的修订记录。" }
];
---
<article class="agent-instrument agent-instrument--delivery" data-agent-instrument="delivery" aria-labelledby={id + "-title"}>
  <header class="agent-instrument__header">
    <div class="agent-instrument__heading">
      <p class="agent-instrument__eyebrow">02 / 已验收交付</p>
      <h2 class="agent-instrument__name" id={id + "-title"}>交付票夹</h2>
    </div>
    <div class="agent-instrument__measurement">
      <p class="agent-instrument__reading"><strong class="agent-instrument__value">{formatted}</strong><span class="agent-instrument__unit">项</span></p>
      <p class="agent-instrument__coverage">{coverageLabel}</p>
    </div>
  </header>
  <p class="agent-instrument__demo" id={id + "-demo"}><span class="agent-instrument__demo-dot" aria-hidden="true"></span>交互示意 · 不计入实测</p>

  <div class="agent-delivery__tickets" id={id + "-tickets"}>
    {tickets.map((ticket,index) => <section class="agent-delivery__ticket" data-delivery-ticket hidden={index !== 0} aria-label={"示意票据 " + ticket.number + "：" + ticket.title}>
      <div class="agent-delivery__ticket-top"><span class="agent-delivery__serial">DEMO / {ticket.number}</span><span class="agent-delivery__category">{ticket.category}</span></div>
      <h3 class="agent-delivery__title">{ticket.title}</h3>
      <details class="agent-delivery__details">
        <summary><span>展开验收依据</span><span class="agent-delivery__detail-mark" aria-hidden="true">＋</span></summary>
        <dl class="agent-delivery__evidence">
          <div><dt>验收条件</dt><dd>{ticket.criterion}</dd></div>
          <div><dt>证据说明</dt><dd>{ticket.evidence}</dd></div>
        </dl>
      </details>
    </section>)}
  </div>
  <nav class="agent-delivery__navigation" aria-label="翻阅示意票据">
    <button class="agent-delivery__page-button" type="button" data-delivery-prev data-instrument-control aria-label="上一张示意票据" aria-controls={id + "-tickets"} disabled><span aria-hidden="true">←</span><span>上一张</span></button>
    <output class="agent-delivery__index" data-delivery-index aria-live="polite">1 / 3</output>
    <button class="agent-delivery__page-button" type="button" data-delivery-next data-instrument-control aria-label="下一张示意票据" aria-controls={id + "-tickets"} disabled><span>下一张</span><span aria-hidden="true">→</span></button>
  </nav>
</article>
