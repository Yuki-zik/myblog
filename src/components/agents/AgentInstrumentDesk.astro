---
import { summary } from "../../lib/agents/observatory";
import ParallelWidget from "./instruments/ParallelWidget.astro";
import DeliveryWidget from "./instruments/DeliveryWidget.astro";
import AttentionWidget from "./instruments/AttentionWidget.astro";
import ReworkWidget from "./instruments/ReworkWidget.astro";
import "../../styles/agent-instruments.css";
interface Props { id?: string; }
const { id = "agent-instrument-desk" } = Astro.props;
---
<section id={id} class="agent-instruments" data-agent-instruments data-agent-instrument-desk aria-label="四件 Agent 工作观察挂件">
  <ParallelWidget id={id + "-parallel"} value={summary.peakParallel} coverage={summary.coverage.peak} observedDays={summary.observedDays} />
  <DeliveryWidget id={id + "-delivery"} value={summary.acceptedTasks} coverage={summary.coverage.accepted} observedDays={summary.observedDays} />
  <AttentionWidget id={id + "-attention"} value={summary.humanHours} coverage={summary.coverage.human} observedDays={summary.observedDays} />
  <ReworkWidget id={id + "-rework"} value={summary.reworkHours} coverage={summary.coverage.rework} observedDays={summary.observedDays} />
  <noscript><p class="agent-instruments__noscript">个人实测与示意图可直接阅读；启用 JavaScript 后可拨动、翻页和回卷。</p></noscript>
</section>
