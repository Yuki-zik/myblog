---
interface Props { path: string; locale: "en" | "zh-CN" }
const { path, locale } = Astro.props;
const en=locale==="en";
---
<span class="post-header-stat article-visits" title={en ? "Consenting visits to this edition; repeats within eight hours are deduplicated. Up to 730 days retained. A dash means unavailable." : "本语言版本的已授权访问估计，八小时内重复访问去重，最多保留730天。横线表示暂不可用。"}>
  <svg aria-hidden="true" class="post-header-stat-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
  <span data-public-visit-count={path} data-count-state="unavailable">—</span>
  <span>{en ? "tracked visits" : "统计访问"}</span>
</span>
<style>.article-visits{font-variant-numeric:tabular-nums}.article-visits [data-public-visit-count]{min-width:1ch}</style>
