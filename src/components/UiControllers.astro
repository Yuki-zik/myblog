---
import { getLocale, createTranslator } from "../lib/i18n/index";
const locale = getLocale(Astro.url.pathname);
const t = createTranslator(locale);

const uiMessages = Object.fromEntries(["[data-reading-progress-region]", "en-US", "site-header-framechange", "亮色", "切换主题（当前：亮色）", "切换主题（当前：深色）", "切换主题（当前：跟随系统）", "原始尺寸", "图片加载失败，可尝试查看原图。", "放大到原始尺寸", "正在加载图片…", "深色", "系统", "缩小到适应窗口", "适应窗口"].map(key => [key, t(key)]));

---
<script is:inline define:vars={{ uiMessages }}>
const t = (key, values = []) => (uiMessages[key] ?? key).replace(/\{(\d+)\}/g, (match, index) => Number(index) < values.length ? String(values[Number(index)]) : match);

  (function () {
    document.documentElement.classList.remove("no-js");

    function initReveal() {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      var STAGGER_MS = 50;
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;

          var el = entry.target;
          var delay = parseInt(el.dataset.uxDelay || "0", 10);
          el.style.animationDelay = delay + "ms";
          el.classList.add("ux-revealed");
          observer.unobserve(el);
        });
      }, {
        threshold: 0.08,
        rootMargin: "0px 0px -40px 0px"
      });

      document.querySelectorAll("[data-ux-reveal]").forEach(function (el) {
        observer.observe(el);
      });

      document.querySelectorAll("[data-ux-stagger]").forEach(function (parent) {
        var children = parent.querySelectorAll("[data-ux-reveal]");
        children.forEach(function (child, index) {
          child.dataset.uxDelay = String(index * STAGGER_MS);
        });
      });
    }

    function initThemeToggle() {
      var root = document.documentElement;
      var toggle = document.getElementById("theme-toggle");
      if (!toggle) return;

      var storageKey = "theme-preference";
      var order = ["system", "light", "dark"];
      var currentPreference = "system";
      var transitionResetTimer = 0;
      var icons = {
        system: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="11.5" rx="2.4"></rect><path d="M8.5 20h7"></path><path d="M12 16v4"></path><path d="M8.2 10.2h2.6v-2.6"></path><path d="M15.8 9.8h-2.6v2.6"></path><path d="M10.8 7.6 8.2 10.2"></path><path d="m13.2 12.4 2.6-2.6"></path></svg>',
        light: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.4"></circle><path d="M12 2.3v2.8"></path><path d="M12 18.9v2.8"></path><path d="M5.2 5.2l2 2"></path><path d="M16.8 16.8l2 2"></path><path d="M2.3 12h2.8"></path><path d="M18.9 12h2.8"></path><path d="M5.2 18.8l2-2"></path><path d="M16.8 7.2l2-2"></path></svg>',
        dark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.2 14.7A8.4 8.4 0 1 1 9.3 3.8a6.9 6.9 0 1 0 10.9 10.9Z"></path></svg>'
      };
      var labels = {
        system: t("系统"),
        light: t("亮色"),
        dark: t("深色")
      };
      var ariaLabels = {
        system: t("切换主题（当前：跟随系统）"),
        light: t("切换主题（当前：亮色）"),
        dark: t("切换主题（当前：深色）")
      };
      var iconEl = toggle.querySelector(".theme-toggle-icon");
      var labelEl = toggle.querySelector(".theme-toggle-label");
      var media = window.matchMedia("(prefers-color-scheme: dark)");

      function getPreference() {
        try {
          var stored = localStorage.getItem(storageKey);
          return order.indexOf(stored || "") > -1 ? stored : "system";
        } catch {
          return "system";
        }
      }

      function resolvePreference(preference) {
        return preference === "system" ? (media.matches ? "dark" : "light") : preference;
      }

      function applyPreference(preference, options) {
        currentPreference = preference;
        var animate = !options || options.animate !== false;
        var resolved = resolvePreference(preference);

        window.clearTimeout(transitionResetTimer);
        if (animate) {
          root.classList.add("theme-transitioning");
        } else {
          root.classList.remove("theme-transitioning");
        }

        root.dataset.theme = preference;
        root.dataset.colorScheme = resolved;
        root.style.colorScheme = resolved;

        if (iconEl) {
          iconEl.innerHTML = icons[preference];
          if (animate) {
            iconEl.style.animation = "none";
            iconEl.offsetHeight;
            iconEl.style.animation =
              "ux-icon-rotate 420ms cubic-bezier(0.25, 1, 0.5, 1)";
          } else {
            iconEl.style.animation = "";
          }
        }

        if (labelEl) labelEl.textContent = labels[preference];
        toggle.setAttribute("aria-label", ariaLabels[preference]);

        if (animate) {
          transitionResetTimer = window.setTimeout(function () {
            root.classList.remove("theme-transitioning");
          }, 700);
        }
      }

      toggle.addEventListener("click", function () {
        var currentIndex = order.indexOf(currentPreference);
        var next = order[(currentIndex + 1) % order.length];

        try {
          localStorage.setItem(storageKey, next);
        } catch {
          // Private mode or blocked storage: the toggle still works for this page.
        }
        applyPreference(next);
      });

      media.addEventListener("change", function () {
        if (currentPreference === "system") {
          applyPreference("system");
        }
      });

      applyPreference(getPreference(), { animate: false });
    }

    function initBackToTop() {
      var btn = document.getElementById("back-to-top");
      if (!btn) return;

      var THRESHOLD = 300;
      var visible = false;

      function updateVisibility() {
        var shouldShow = window.scrollY > THRESHOLD;
        if (shouldShow !== visible) {
          visible = shouldShow;
          btn.classList.toggle("is-visible", visible);
        }
      }

      window.addEventListener("scroll", updateVisibility, { passive: true });
      updateVisibility();

      btn.addEventListener("click", function () {
        var prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({ top: 0, behavior: prefersReduced ? "auto" : "smooth" });
      });
    }

    function initHeader() {
      var header = document.querySelector(".site-header");
      if (!header) return;

      function notifyHeaderFrameChange() {
        window.dispatchEvent(new CustomEvent("site-header-framechange"));
      }

      var state = "top";
      var lastY = window.scrollY;
      var downTravel = 0;
      var upTravel = 0;
      var ticking = false;
      var TOP_THRESHOLD = 10;
      var COMPACT_THRESHOLD = 60;
      var HIDE_THRESHOLD = 240;
      var HIDE_DELTA = 120;
      var COMPACT_DWELL_MS = 820;
      var SHOW_DELTA = 38;
      var IGNORE_DELTA = 4;
      var HOVER_ZONE = 108;
      var clarity = "normal";
      var hoverReveal = false;
      var compactSince = 0;
      var hideTimer = null;

      function clearHideTimer() {
        if (hideTimer === null) return;
        window.clearTimeout(hideTimer);
        hideTimer = null;
      }

      function writeState(nextState) {
        header.dataset.headerState = nextState;
        header.classList.toggle("is-scrolled", nextState !== "top");
        header.classList.toggle("is-hidden", nextState === "hidden");
        if (nextState === "compact") {
          compactSince = performance.now();
          scheduleHideAfterDwell();
        }
        notifyHeaderFrameChange();
      }

      /*
       * The surface is scaled up to cover the viewport at the top of the page.
       * CSS cannot divide one length by another, so the factor is computed here
       * and written once per resize. `offsetWidth` and `offsetHeight` report the
       * untransformed layout box, so reading them while the scroll-driven
       * animation is mid-flight still yields the pill's real size.
       */
      function syncHeaderScale() {
        var surface = header.querySelector(".site-header-inner");
        if (!(surface instanceof HTMLElement)) return;

        var pillWidth = surface.offsetWidth;
        var pillHeight = surface.offsetHeight;
        if (pillWidth <= 0 || pillHeight <= 0) return;

        var band = header.offsetHeight || pillHeight;
        // The header occupies this much document flow. Keep the surface full
        // width until page content has scrolled behind that reserved band.
        // Mobile has two rows, so its actual height exceeds --header-band.
        header.style.setProperty("--header-collapse-start", band + "px");
        // Overscan so the pill's rounded corners and side borders finish
        // outside the viewport, which is what reads as a full-bleed bar.
        var overscan = 96;

        header.style.setProperty(
          "--header-expand-x",
          String((window.innerWidth + overscan) / pillWidth)
        );
        header.style.setProperty("--header-expand-y", String(band / pillHeight));
      }

      function scheduleHideAfterDwell() {
        if (state !== "compact" || hideTimer !== null) return;
        var elapsed = performance.now() - compactSince;
        var remaining = Math.max(COMPACT_DWELL_MS - elapsed, 0);

        hideTimer = window.setTimeout(function () {
          hideTimer = null;
          var y = Math.max(window.scrollY, 0);
          if (
            state === "compact" &&
            y >= HIDE_THRESHOLD &&
            downTravel >= HIDE_DELTA
          ) {
            applyState("hidden");
            downTravel = 0;
          }
        }, remaining);
      }

      function applyState(nextState) {
        if (state === nextState && header.dataset.headerState === nextState) return;
        state = nextState;
        clearHideTimer();
        writeState(nextState);
      }

      function applyClarity(nextClarity) {
        if (clarity === nextClarity && header.dataset.headerClarity === nextClarity) return;
        clarity = nextClarity;
        header.dataset.headerClarity = nextClarity;
      }

      function applyHoverReveal(nextHoverReveal) {
        if (hoverReveal === nextHoverReveal) return;
        hoverReveal = nextHoverReveal;
        header.classList.toggle("is-hover-revealed", nextHoverReveal);
        applyClarity(nextHoverReveal ? "hover" : "normal");
        notifyHeaderFrameChange();
      }

      function syncInitialState() {
        var y = Math.max(window.scrollY, 0);
        state = y <= TOP_THRESHOLD ? "top" : "compact";
        compactSince = state === "compact" ? performance.now() : 0;
        clearHideTimer();
        downTravel = 0;
        upTravel = 0;
        lastY = y;
        header.dataset.headerState = state;
        header.dataset.headerClarity = "normal";
        header.classList.toggle("is-scrolled", state !== "top");
        header.classList.toggle("is-hidden", state === "hidden");
        header.classList.remove("is-hover-revealed");
        notifyHeaderFrameChange();
      }

      function update() {
        var y = Math.max(window.scrollY, 0);
        var delta = y - lastY;
        var absDelta = Math.abs(delta);

        if (y <= TOP_THRESHOLD) {
          downTravel = 0;
          upTravel = 0;
          applyState("top");
          lastY = y;
          ticking = false;
          return;
        }

        if (absDelta <= IGNORE_DELTA) {
          lastY = y;
          ticking = false;
          return;
        }

        if (delta > 0) {
          downTravel += delta;
          upTravel = 0;
        } else {
          upTravel += Math.abs(delta);
          downTravel = 0;
          clearHideTimer();
        }

        if (state === "top" && y >= COMPACT_THRESHOLD) {
          applyState("compact");
          downTravel = Math.max(y - COMPACT_THRESHOLD, 0);
        }

        if (state === "compact") {
          if (delta > 0 && y >= HIDE_THRESHOLD && downTravel >= HIDE_DELTA) {
            if (
              compactSince > 0 &&
              performance.now() - compactSince >= COMPACT_DWELL_MS
            ) {
              applyState("hidden");
              downTravel = 0;
            } else if (compactSince > 0) {
              scheduleHideAfterDwell();
            }
          }
        } else if (state === "hidden") {
          if (upTravel >= SHOW_DELTA) {
            applyState("compact");
            upTravel = 0;
          }
        }

        if (state !== "top" && y < COMPACT_THRESHOLD && y > TOP_THRESHOLD) {
          applyState("compact");
        }

        lastY = y;
        ticking = false;
      }

      window.addEventListener("scroll", function () {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }, { passive: true });

      window.addEventListener("mousemove", function (event) {
        if (!(event instanceof MouseEvent)) return;
        applyHoverReveal(event.clientY <= HOVER_ZONE);
      }, { passive: true });

      window.addEventListener("mouseleave", function () {
        applyHoverReveal(false);
      });

      window.addEventListener("resize", syncHeaderScale, { passive: true });

      syncHeaderScale();
      syncInitialState();
    }

    function initDomainsCarousel() {
      document.querySelectorAll('[data-controller~="domains-carousel"]').forEach(function (root) {
        var viewport = root.querySelector("[data-home-domains-viewport]");
        var track = root.querySelector("[data-home-domains-track]");
        var previousButton = root.querySelector("[data-home-domains-prev]");
        var nextButton = root.querySelector("[data-home-domains-next]");

        if (!(viewport instanceof HTMLElement) || !(track instanceof HTMLElement)) return;

        var cardSelector = "[data-home-domain-card]";
        var motionReduced = window.matchMedia("(prefers-reduced-motion: reduce)");
        var desktopViewport = window.matchMedia("(min-width: 1024px)");
        var isAnimating = false;
        var pendingDirections = [];
        var activeDirection = 0;
        var wheelDeltaBuffer = 0;

        function getCards() {
          return Array.from(track.querySelectorAll(cardSelector)).filter(function (card) {
            return card instanceof HTMLElement;
          });
        }

        function canLoop() {
          return desktopViewport.matches && getCards().length > 4;
        }

        function updateButtons() {
          var loopActive = canLoop();
          var trackStyles = window.getComputedStyle(track);
          var gap = Number.parseFloat(trackStyles.columnGap || trackStyles.gap || "16");
          var cardWidth = Math.max(0, Math.floor((viewport.clientWidth - gap * 3) / 4));

          viewport.style.setProperty("--home-domains-card-width", cardWidth + "px");
          viewport.dataset.loop = loopActive ? "true" : "false";
          if (previousButton instanceof HTMLButtonElement) {
            previousButton.disabled = !loopActive;
          }
          if (nextButton instanceof HTMLButtonElement) {
            nextButton.disabled = !loopActive;
          }
        }

        function syncAnimationState() {
          viewport.dataset.animating = isAnimating || pendingDirections.length > 0 ? "true" : "false";
        }

        function clearActiveAnimation() {
          var activeAnimation = track.__homeDomainsTrackAnimation;
          if (activeAnimation) {
            activeAnimation.onfinish = null;
            activeAnimation.oncancel = null;
            activeAnimation.cancel();
            track.__homeDomainsTrackAnimation = null;
          }
        }

        function cleanupAnimation() {
          clearActiveAnimation();
          track.style.willChange = "";
          track.style.transform = "";
          isAnimating = false;
          activeDirection = 0;
          syncAnimationState();
        }

        function boostActiveAnimation() {
          if (motionReduced.matches) return;

          var activeAnimation = track.__homeDomainsTrackAnimation;
          if (!activeAnimation) return;

          var nextRate = Math.min(5.5, Math.max(activeAnimation.playbackRate || 1, 1.45) + 0.9);
          activeAnimation.playbackRate = nextRate;
        }

        function pullNextBurst() {
          var nextDirection = pendingDirections.shift();
          if (!nextDirection) return null;

          var stepCount = 1;
          while (pendingDirections[0] === nextDirection) {
            pendingDirections.shift();
            stepCount += 1;
          }

          return {
            direction: nextDirection,
            stepCount: stepCount
          };
        }

        function rotateNext(cards, stepCount) {
          cards.slice(0, stepCount).forEach(function (card) {
            track.appendChild(card);
          });
        }

        function rotatePrevious(cards, stepCount) {
          var movedCards = cards.slice(-stepCount);
          for (var index = movedCards.length - 1; index >= 0; index -= 1) {
            track.insertBefore(movedCards[index], track.firstChild);
          }
        }

        function resolveCycleDuration(stepCount) {
          if (stepCount <= 1) {
            return 520;
          }

          return Math.min(700, 340 + (stepCount - 1) * 80);
        }

        function drainQueue() {
          if (isAnimating) return;
          if (!canLoop()) {
            pendingDirections.length = 0;
            cleanupAnimation();
            return;
          }

          var nextBurst = pullNextBurst();
          if (!nextBurst) {
            syncAnimationState();
            return;
          }

          startCycle(nextBurst.direction, nextBurst.stepCount);
        }

        function startCycle(direction, stepCount) {
          var cards = getCards();
          if (cards.length <= 1) return;

          var cycleSteps = Math.max(1, Math.min(stepCount || 1, cards.length));
          var trackStyles = window.getComputedStyle(track);
          var gap = Number.parseFloat(trackStyles.columnGap || trackStyles.gap || "16");
          var firstCard = cards[0];
          if (!(firstCard instanceof HTMLElement)) return;
          var step = firstCard.getBoundingClientRect().width + gap;
          var distance = step * cycleSteps;

          if (direction > 0) {
            // next: animate the whole track left, then rotate the first card to the end.
          } else {
            // prev: pre-rotate the last card to the front, offset the track left by one card,
            // then animate it back to zero so the motion mirrors the "next" direction.
            rotatePrevious(cards, cycleSteps);
            track.style.transform = "translate3d(" + (-distance) + "px, 0, 0)";
          }

          isAnimating = !motionReduced.matches;
          activeDirection = direction;
          syncAnimationState();

          if (motionReduced.matches) {
            if (direction > 0) {
              rotateNext(cards, cycleSteps);
            }
            cleanupAnimation();
            window.requestAnimationFrame(drainQueue);
            return;
          }

          window.requestAnimationFrame(function () {
            track.style.willChange = "transform";
            var fromX = direction > 0 ? 0 : -distance;
            var toX = direction > 0 ? -distance : 0;

            if (track.__homeDomainsTrackAnimation) {
              track.__homeDomainsTrackAnimation.cancel();
            }

            var duration = resolveCycleDuration(cycleSteps);
            var animation = track.animate([
              {
                transform: "translate3d(" + fromX + "px, 0, 0)"
              },
              {
                transform: "translate3d(" + toX + "px, 0, 0)"
              }
            ], {
              duration: duration,
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              fill: "both"
            });
            track.__homeDomainsTrackAnimation = animation;

            animation.onfinish = function () {
              if (track.__homeDomainsTrackAnimation !== animation) return;
              if (direction > 0) {
                rotateNext(cards, cycleSteps);
              }
              cleanupAnimation();
              drainQueue();
            };
          });
        }

        function queueCycle(direction) {
          if (!canLoop()) return;

          pendingDirections.push(direction);
          syncAnimationState();

          if (isAnimating) {
            if (activeDirection === direction) {
              boostActiveAnimation();
            }
            return;
          }

          drainQueue();
        }

        if (previousButton instanceof HTMLButtonElement) {
          previousButton.addEventListener("click", function () {
            queueCycle(-1);
          });
        }

        if (nextButton instanceof HTMLButtonElement) {
          nextButton.addEventListener("click", function () {
            queueCycle(1);
          });
        }

        viewport.addEventListener("keydown", function (event) {
          if (event.key === "ArrowRight") {
            event.preventDefault();
            queueCycle(1);
          }

          if (event.key === "ArrowLeft") {
            event.preventDefault();
            queueCycle(-1);
          }
        });

        viewport.addEventListener("wheel", function (event) {
          if (!canLoop()) return;

          var horizontalIntent = Math.abs(event.deltaX) > Math.abs(event.deltaY) || event.shiftKey;
          if (!horizontalIntent) return;

          var dominantDelta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
          if (Math.abs(dominantDelta) < 4) return;

          event.preventDefault();
          wheelDeltaBuffer += dominantDelta;

          if (Math.abs(wheelDeltaBuffer) < 90) return;

          queueCycle(wheelDeltaBuffer > 0 ? 1 : -1);
          wheelDeltaBuffer = 0;
        }, { passive: false });

        window.addEventListener("resize", updateButtons);
        updateButtons();
      });
    }

    function initSocialStats() {
      document.querySelectorAll('[data-controller~="social-stats"]').forEach(function (root) {
        var cards = Array.from(root.querySelectorAll("[data-substats-source][data-substats-key]"));
        if (!cards.length) return;

        var formatter = new Intl.NumberFormat("en-US");

        cards.forEach(function (card) {
          var source = card.getAttribute("data-substats-source");
          var key = card.getAttribute("data-substats-key");
          var countEl = card.querySelector("[data-social-count]");
          var labelEl = card.querySelector("[data-social-label]");

          if (!source || !key || !countEl) return;

          fetch("https://api.swo.moe/stats/" + encodeURIComponent(source) + "/" + encodeURIComponent(key), {
            cache: "no-store"
          })
            .then(function (response) {
              if (!response.ok) throw new Error(String(response.status));
              return response.json();
            })
            .then(function (data) {
              if (!data || data.failed || typeof data.count !== "number") {
                throw new Error("invalid count");
              }

              countEl.textContent = formatter.format(data.count);

              if (labelEl && source === "telegram") {
                labelEl.textContent = data.count === 1 ? "subscriber" : "subscribers";
              }

              card.setAttribute("data-social-state", "ready");
            })
            .catch(function () {
              card.setAttribute("data-social-state", "error");
            });
        });
      });
    }

    function initReadingProgress() {
      document.querySelectorAll('[data-controller~="reading-progress"]').forEach(function (bar) {
        var fill = bar.querySelector("[data-reading-progress-fill]");
        if (!(bar instanceof HTMLElement)) return;

        var progressRegion = bar.closest("[data-reading-progress-region]") || bar;
        if (progressRegion.parentElement !== document.body) {
          document.body.appendChild(progressRegion);
        }

        var ticking = false;

        function updateProgress() {
          var article = document.querySelector(".post-reading-article");
          var articleBody = document.querySelector("[data-post-body]");
          if (!(article instanceof HTMLElement) || !(articleBody instanceof HTMLElement)) return;

          var rect = article.getBoundingClientRect();
          var progressAnchorOffset = Math.max(window.innerHeight * 0.025, 24);
          var articleStart = Math.max(window.scrollY + rect.top - progressAnchorOffset, 0);
          var articleEnd =
            articleStart +
            article.offsetHeight -
            Math.min(window.innerHeight * 0.58, articleBody.offsetHeight * 0.2);

          var total = Math.max(articleEnd - articleStart, 1);
          var scrolled = Math.min(Math.max(window.scrollY - articleStart, 0), total);
          var pct = Math.round((scrolled / total) * 100);

          bar.style.setProperty("--progress", pct + "%");

          if (fill instanceof HTMLElement) {
            fill.style.width = pct + "%";
          }

          bar.setAttribute("aria-valuenow", String(pct));
          ticking = false;
        }

        function scheduleProgressUpdate() {
          if (!ticking) {
            window.requestAnimationFrame(updateProgress);
            ticking = true;
          }
        }

        window.addEventListener("scroll", scheduleProgressUpdate, { passive: true });
        window.addEventListener("resize", function () {
          window.requestAnimationFrame(updateProgress);
        });
        window.addEventListener("site-header-framechange", scheduleProgressUpdate);
        updateProgress();
      });
    }

    function initSpoilers() {
      document.querySelectorAll("[data-spoiler-inline]").forEach(function (button) {
        if (!(button instanceof HTMLButtonElement)) return;

        var content = button.querySelector("[data-spoiler-inline-content]");
        if (!(content instanceof HTMLElement)) return;

        button.addEventListener("click", function () {
          var revealed = button.getAttribute("data-revealed") === "true";
          var next = !revealed;

          button.setAttribute("data-revealed", next ? "true" : "false");
          button.setAttribute("aria-pressed", next ? "true" : "false");
          content.setAttribute("aria-hidden", next ? "false" : "true");
        });
      });
    }

    function initImageViewer() {
      var dialog = document.querySelector("[data-image-viewer]");
      if (!dialog || typeof dialog.showModal !== "function") return;
      var viewport = dialog.querySelector("[data-image-viewer-viewport]");
      var image = dialog.querySelector("[data-image-viewer-image]");
      var imageToggle = dialog.querySelector("[data-image-viewer-image-toggle]");
      var toggle = dialog.querySelector("[data-image-viewer-toggle]");
      var original = dialog.querySelector("[data-image-viewer-original]");
      var close = dialog.querySelector("[data-image-viewer-close]");
      var caption = dialog.querySelector("[data-image-viewer-caption]");
      var status = dialog.querySelector("[data-image-viewer-status]");
      if (!viewport || !image || !imageToggle || !toggle || !original || !close || !caption || !status) return;

      var trigger = null;
      var savedScroll = null;
      var loaded = false;
      var zoomed = false;
      var backgroundPress = null;
      var lockedProperties = ["position", "top", "left", "right", "width", "overflow"];

      // Match the existing search dialog's fixed-body lock and exact scroll restoration.
      function lockScroll() {
        savedScroll = {
          x: window.scrollX, y: window.scrollY,
          body: lockedProperties.map(function (property) { return document.body.style.getPropertyValue(property); }),
          htmlOverflow: document.documentElement.style.overflow
        };
        Object.assign(document.body.style, {
          position: "fixed", top: -savedScroll.y + "px", left: -savedScroll.x + "px",
          right: "0", width: "100%", overflow: "hidden"
        });
        document.documentElement.style.overflow = "hidden";
      }

      function contentSize() {
        var style = getComputedStyle(viewport);
        return {
          width: Math.max(1, viewport.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight)),
          height: Math.max(1, viewport.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom))
        };
      }

      function sizeImage() {
        if (!dialog.open || !loaded) return;
        var available = contentSize();
        var fit = Math.min(1, available.width / image.naturalWidth, available.height / image.naturalHeight);
        var canZoom = fit < 1;
        if (!canZoom) zoomed = false;
        var scale = zoomed ? 1 : fit;
        image.style.width = Math.floor(image.naturalWidth * scale) + "px";
        image.style.height = Math.floor(image.naturalHeight * scale) + "px";
        dialog.dataset.zoomed = String(zoomed);
        toggle.textContent = zoomed ? t("适应窗口") : t("原始尺寸");
        toggle.disabled = !canZoom;
        imageToggle.disabled = !canZoom;
        imageToggle.setAttribute("aria-label", zoomed ? t("缩小到适应窗口") : t("放大到原始尺寸"));
        status.textContent = image.naturalWidth + " × " + image.naturalHeight + " · " + Math.round(scale * 100) + "%";
      }

      function toggleSize() {
        if (!loaded || toggle.disabled) return;
        zoomed = !zoomed;
        sizeImage();
        var available = contentSize();
        viewport.scrollTo({
          left: zoomed ? Math.max(0, (image.naturalWidth - available.width) / 2) : 0,
          top: zoomed ? Math.max(0, (image.naturalHeight - available.height) / 2) : 0,
          behavior: "instant"
        });
      }

      function imageLoaded() {
        if (!dialog.open || !image.naturalWidth) return;
        loaded = true;
        dialog.dataset.imageState = "ready";
        sizeImage();
        image.hidden = false;
      }

      image.addEventListener("load", imageLoaded);
      image.addEventListener("error", function () {
        if (!dialog.open) return;
        loaded = false;
        image.hidden = true;
        toggle.disabled = imageToggle.disabled = true;
        dialog.dataset.imageState = "error";
        status.textContent = t("图片加载失败，可尝试查看原图。");
      });

      document.querySelectorAll("[data-image-viewer-trigger]").forEach(function (link) {
        link.addEventListener("click", function (event) {
          // Modified clicks and the no-JS path keep the real original-image link.
          if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          if (dialog.open) return;
          trigger = link;
          zoomed = false;
          loaded = false;
          dialog.dataset.zoomed = "false";
          dialog.dataset.imageState = "loading";
          toggle.textContent = t("原始尺寸");
          toggle.disabled = imageToggle.disabled = true;
          image.hidden = true;
          image.alt = link.dataset.imageAlt || "";
          caption.textContent = image.alt;
          original.href = link.href;
          status.textContent = t("正在加载图片…");
          viewport.scrollTo(0, 0);
          lockScroll();
          dialog.showModal();
          close.focus({ preventScroll: true });
          image.src = link.href;
          if (image.complete && image.naturalWidth > 0) imageLoaded();
        });
      });

      close.addEventListener("click", function () { dialog.close(); });
      toggle.addEventListener("click", toggleSize);
      imageToggle.addEventListener("click", toggleSize);
      dialog.addEventListener("keydown", function (event) {
        // Keep sequential focus in the viewer, including browsers that tab into chrome.
        if (event.key === "Tab") {
          var controls = Array.from(dialog.querySelectorAll("button:not(:disabled), a[href]")).filter(function (element) {
            return element.getClientRects().length > 0;
          });
          var first = controls[0];
          var last = controls[controls.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus({ preventScroll: true });
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus({ preventScroll: true });
          }
        }
        // Escape keeps its native default; page shortcuts stay behind the modal.
        event.stopPropagation();
      });
      dialog.addEventListener("pointerdown", function (event) {
        backgroundPress = event.target === dialog || event.target === viewport
          ? { x: event.clientX, y: event.clientY } : null;
      });
      dialog.addEventListener("click", function (event) {
        event.stopPropagation();
        if ((event.target === dialog || event.target === viewport) && backgroundPress &&
            Math.hypot(event.clientX - backgroundPress.x, event.clientY - backgroundPress.y) < 8) dialog.close();
        backgroundPress = null;
      });
      dialog.addEventListener("close", function () {
        loaded = false;
        image.hidden = true;
        image.removeAttribute("src");
        if (savedScroll) {
          var saved = savedScroll;
          savedScroll = null;
          lockedProperties.forEach(function (property, index) { document.body.style.setProperty(property, saved.body[index]); });
          document.documentElement.style.overflow = saved.htmlOverflow;
          window.scrollTo({ left: saved.x, top: saved.y, behavior: "instant" });
        }
        if (trigger && trigger.isConnected) trigger.focus({ preventScroll: true });
      });
      new ResizeObserver(sizeImage).observe(viewport);
    }


    function initAgentInstruments() {
      document.querySelectorAll("[data-agent-instruments]").forEach(function (desk) {
        if (desk.dataset.ready === "true") return;

        function write(selector, value) {
          var target = desk.querySelector(selector);
          if (target) target.textContent = String(value);
        }

        var parallel = desk.querySelector("[data-parallel-scrub]");
        var parallelStage = desk.querySelector("[data-parallel-stage]");
        function updateParallel() {
          if (!parallel) return;
          var point = Math.min(120, Math.max(0, Number(parallel.value) || 0));
          var running = 0;
          desk.querySelectorAll("[data-parallel-segment]").forEach(function (segment) {
            var active = Number(segment.dataset.start) <= point && point < Number(segment.dataset.end);
            segment.dataset.active = active ? "true" : "false";
            if (active) running += 1;
          });
          if (parallelStage) parallelStage.style.setProperty("--cursor", (point / 120 * 100) + "%");
          write("[data-parallel-time]", point + " min");
          write("[data-parallel-count]", running);
          parallel.setAttribute("aria-valuetext", "示意第 " + point + " 分钟，同时推进 " + running + " 项任务");
        }
        if (parallel) parallel.addEventListener("input", updateParallel);
        updateParallel();

        var tickets = Array.from(desk.querySelectorAll("[data-delivery-ticket]"));
        var ticketIndex = 0;
        function showTicket(nextIndex) {
          if (!tickets.length) return;
          ticketIndex = (nextIndex + tickets.length) % tickets.length;
          tickets.forEach(function (ticket, index) {
            ticket.hidden = index !== ticketIndex;
            if (ticket.hidden) ticket.querySelectorAll("details").forEach(function (detail) { detail.open = false; });
          });
          write("[data-delivery-index]", (ticketIndex + 1) + " / " + tickets.length);
        }
        var previousTicket = desk.querySelector("[data-delivery-prev]");
        var nextTicket = desk.querySelector("[data-delivery-next]");
        if (previousTicket) previousTicket.addEventListener("click", function () { showTicket(ticketIndex - 1); });
        if (nextTicket) nextTicket.addEventListener("click", function () { showTicket(ticketIndex + 1); });
        showTicket(0);

        var attentionParts = {
          plan: { minutes: 30, description: "界定目标、准备上下文与拆分任务。"},
          review: { minutes: 45, description: "检查结果、核对依据并完成整合。"},
          rework: { minutes: 15, description: "纠错与重做；这部分已经包含在总投入中。"}
        };
        var attentionDial = desk.querySelector("[data-attention-dial]");
        var partButtons = Array.from(desk.querySelectorAll("[data-attention-part]"));
        function showAttention(part) {
          var item = attentionParts[part];
          if (!item) return;
          partButtons.forEach(function (button) {
            button.setAttribute("aria-pressed", button.dataset.attentionPart === part ? "true" : "false");
          });
          if (attentionDial) attentionDial.dataset.part = part;
          write("[data-attention-output]", item.minutes + " 分钟");
          write("[data-attention-description]", item.description);
        }
        partButtons.forEach(function (button) {
          button.addEventListener("click", function () { showAttention(button.dataset.attentionPart); });
        });
        showAttention("plan");

        var rework = desk.querySelector("[data-rework-scrub]");
        var reworkTape = desk.querySelector("[data-rework-tape]");
        function updateRework() {
          if (!rework) return;
          var minutes = Math.min(90, Math.max(0, Number(rework.value) || 0));
          if (reworkTape) reworkTape.style.setProperty("--rework", (minutes / 90 * 100) + "%");
          write("[data-rework-output]", minutes + " 分钟");
          rework.setAttribute("aria-valuetext", "示意总投入 90 分钟，其中返工 " + minutes + " 分钟");
        }
        if (rework) rework.addEventListener("input", updateRework);
        var resetRework = desk.querySelector("[data-rework-reset]");
        if (resetRework && rework) resetRework.addEventListener("click", function () { rework.value = "0"; updateRework(); });
        updateRework();

        desk.querySelectorAll("[data-instrument-control]").forEach(function (control) { control.disabled = false; });
        desk.dataset.ready = "true";
      });
    }

    function initResearchSignature() {
      var signatures = document.querySelectorAll("details[data-home-research-signature]");
      if (!signatures.length) return;

      var desktop = window.matchMedia("(min-width: 1024px)");
      function syncSignatureLayout() {
        signatures.forEach(function (signature) {
          if (signature instanceof HTMLDetailsElement) signature.open = desktop.matches;
        });
      }
      syncSignatureLayout();
      desktop.addEventListener("change", syncSignatureLayout);
    }

    initReveal();
    initResearchSignature();
    initAgentInstruments();
    initThemeToggle();
    initBackToTop();
    initHeader();
    initDomainsCarousel();
    initSocialStats();
    initReadingProgress();
    initSpoilers();
    initImageViewer();
  })();
</script>
