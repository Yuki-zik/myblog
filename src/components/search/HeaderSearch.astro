---
---

<div class="header-search relative flex items-center w-full max-w-full" data-header-search>
  <button
    type="button"
    class="header-search-trigger inline-flex items-center w-full min-h-[2.56rem] gap-[0.58rem] rounded-lg border py-[0.16rem] pr-[0.3rem] pl-[0.72rem] text-left cursor-pointer"
    aria-label="&#x6253;&#x5f00;&#x641c;&#x7d22;"
    title="搜索（/ 或 Ctrl/⌘+K）"
    data-search-trigger
  >
    <span class="header-search-trigger-icon inline-flex items-center justify-center flex-none size-[0.96rem]" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </span>
    <span class="header-search-trigger-text min-w-0 flex-auto truncate text-[0.84rem] font-[540] tracking-[-0.025em]">搜索文章 / 主题 / 概念</span>
    <span class="header-search-trigger-shortcut flex-none rounded-full border py-[0.18rem] px-[0.48rem] text-[0.62rem] font-bold" aria-hidden="true">/</span>
  </button>

  <div class="header-search-field items-center w-full min-h-[2.56rem] gap-[0.52rem] rounded-lg border py-[0.16rem] pr-[0.22rem] pl-[0.68rem]" data-search-field>
    <span class="header-search-field-icon inline-flex items-center justify-center flex-none size-[0.96rem]" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </span>
    <label class="sr-only" for="site-search-input">
      &#x641c;&#x7d22;&#x7ad9;&#x5185;&#x5185;&#x5bb9;
    </label>
    <input
      id="site-search-input"
      class="header-search-input w-full p-0 bg-transparent"
      type="search"
      placeholder="&#x641c;&#x7d22;&#x6587;&#x7ae0; / &#x4e3b;&#x9898; / &#x6982;&#x5ff5;"
      autocomplete="off"
      enterkeyhint="search"
      data-search-input
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="site-search-results"
      role="combobox"
    />
    <button
      type="button"
      class="header-search-close inline-flex items-center justify-center flex-none size-8 rounded-full border cursor-pointer"
      aria-label="&#x5173;&#x95ed;&#x641c;&#x7d22;"
      data-search-close
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.15" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div
    class="header-search-panel absolute left-0 top-[calc(100%+0.55rem)] z-90 w-[min(34rem,calc(100vw-1rem))] min-w-[min(100%,18rem)] rounded-lg border p-[0.55rem] shadow-elev-3"
    data-search-panel
    hidden
  >
    <p class="header-search-status subtle pt-[0.18rem] px-[0.35rem] pb-[0.48rem] text-[0.78rem]" data-search-status></p>
    <ul
      class="header-search-results grid list-none p-0 gap-[0.18rem] max-h-[min(65vh,420px)] overflow-auto"
      id="site-search-results"
      data-search-results
      role="listbox"
    ></ul>
  </div>
</div>

<script>
  import { searchIndexItems, type SearchIndexItem } from "../../lib/search/index";

  const SEARCH_TYPE_LABELS: Record<SearchIndexItem["type"], string> = {
    post: "\u6587\u7ae0",
    topic: "\u4e3b\u9898",
    concept: "\u6982\u5ff5"
  };

  const MESSAGES = {
    loading: "\u6b63\u5728\u641c\u7d22\u2026",
    none: "\u672a\u627e\u5230\u7ed3\u679c",
    loadError: "\u641c\u7d22\u7d22\u5f15\u52a0\u8f7d\u5931\u8d25\uff0c\u8bf7\u7a0d\u540e\u91cd\u8bd5",
    keywords: "\u5173\u952e\u8bcd\uff1a",
    resultCount: (count: number) => `\u627e\u5230 ${count} \u6761\u7ed3\u679c`
  };

  /* Tailwind scans these literals, so result rows get the same utility
     treatment as the server-rendered markup above. */
  const RESULT_ITEM_CLASS = "header-search-result-item m-0";
  const RESULT_LINK_CLASS =
    "header-search-result-link block rounded-[14px] border border-transparent bg-transparent py-[0.72rem] px-[0.8rem]";
  const RESULT_TOP_CLASS = "header-search-result-top flex items-start justify-between gap-2";
  const RESULT_TITLE_CLASS = "header-search-result-title text-ink font-semibold leading-[1.35]";
  const RESULT_TYPE_CLASS =
    "header-search-result-type flex-none rounded-full border bg-surface-subtle text-ink-muted py-[0.16rem] px-[0.46rem] text-[0.68rem] font-bold tracking-[0.04em]";
  const RESULT_SUMMARY_CLASS = "header-search-result-summary text-ink-muted text-[0.86rem] leading-[1.5]";

  const searchCache: {
    items: SearchIndexItem[] | null;
    promise: Promise<SearchIndexItem[]> | null;
  } = {
    items: null,
    promise: null
  };

  function truncateText(value: string, maxLength: number): string {
    if (!value || value.length <= maxLength) {
      return value;
    }

    return value.slice(0, maxLength - 1).trimEnd() + "...";
  }

  async function ensureSearchIndexLoaded(): Promise<SearchIndexItem[]> {
    if (Array.isArray(searchCache.items)) {
      return searchCache.items;
    }

    if (!searchCache.promise) {
      searchCache.promise = fetch("/search-index.json", {
        headers: {
          Accept: "application/json"
        }
      })
        .then(async (response) => {
          if (!response.ok) {
            throw new Error("Failed to load search index");
          }

          const payload = (await response.json()) as unknown;
          return Array.isArray(payload) ? (payload as SearchIndexItem[]) : [];
        })
        .then((payload) => {
          searchCache.items = payload;
          return payload;
        })
        .catch((error) => {
          searchCache.promise = null;
          throw error;
        });
    }

    return searchCache.promise;
  }

  function initHeaderSearch(root: Element): void {
    if (!(root instanceof HTMLElement) || root.dataset.ready === "true") {
      return;
    }
    root.dataset.ready = "true";

    const trigger = root.querySelector<HTMLButtonElement>("[data-search-trigger]");
    const field = root.querySelector<HTMLElement>("[data-search-field]");
    const input = root.querySelector<HTMLInputElement>("[data-search-input]");
    const panel = root.querySelector<HTMLElement>("[data-search-panel]");
    const status = root.querySelector<HTMLElement>("[data-search-status]");
    const list = root.querySelector<HTMLElement>("[data-search-results]");
    const closeBtn = root.querySelector<HTMLButtonElement>("[data-search-close]");

    if (!trigger || !field || !input || !panel || !status || !list || !closeBtn) {
      return;
    }

    const triggerEl = trigger;
    const inputEl = input;
    const panelEl = panel;
    const statusEl = status;
    const listEl = list;
    const closeBtnEl = closeBtn;
    const rootEl = root;
    let renderToken = 0;
    let activeIndex = -1;
    let currentResults: SearchIndexItem[] = [];

    function setExpanded(expanded: boolean): void {
      inputEl.setAttribute("aria-expanded", expanded ? "true" : "false");
    }

    function closePanel(): void {
      panelEl.hidden = true;
      setExpanded(false);
      setActiveIndex(-1);
    }

    function openPanel(): void {
      panelEl.hidden = false;
      setExpanded(true);
    }

    function clearResults(): void {
      listEl.replaceChildren();
      currentResults = [];
      setActiveIndex(-1);
    }

    function renderStatus(message: string): void {
      statusEl.textContent = message;
      statusEl.hidden = message.length === 0;
    }

    function getResultOptions(): HTMLElement[] {
      return Array.from(listEl.querySelectorAll<HTMLElement>("[role='option']"));
    }

    function setActiveIndex(nextIndex: number): void {
      const options = getResultOptions();
      activeIndex = options.length === 0 ? -1 : Math.max(0, Math.min(nextIndex, options.length - 1));

      options.forEach((option, index) => {
        const selected = index === activeIndex;
        option.classList.toggle("is-active", selected);
        option.setAttribute("aria-selected", selected ? "true" : "false");
      });

      if (activeIndex >= 0 && options[activeIndex]) {
        inputEl.setAttribute("aria-activedescendant", options[activeIndex].id);
      } else {
        inputEl.removeAttribute("aria-activedescendant");
      }
    }

    function navigateToActiveResult(): void {
      const options = getResultOptions();
      const activeOption = activeIndex >= 0 ? options[activeIndex] : options[0];
      const link = activeOption?.querySelector("a");
      if (link instanceof HTMLAnchorElement) {
        window.location.href = link.href;
      }
    }

    /* ── Open / Close search field ─────────────── */
    function openSearch(): void {
      rootEl.classList.add("is-open");
      triggerEl.hidden = true;
      inputEl.focus();
      void ensureSearchIndexLoaded().catch(() => undefined);
    }

    function closeSearch(options?: { restoreFocus?: boolean }): void {
      /*
       * Explicit dismissals hand focus back to the trigger.
       *
       * Without this, closing the field drops focus on <body>: keyboard users
       * lose their place in the header and have to tab in from the top again.
       * It also makes the post-close focus target deterministic, which matters
       * because the `/` shortcut deliberately ignores keystrokes aimed at an
       * editable element.
       *
       * Dismissal by clicking elsewhere deliberately opts out — the user is
       * already moving focus somewhere of their own choosing, and pulling it
       * back to the trigger would fight them.
       */
      const restoreFocus = options?.restoreFocus === true && rootEl.contains(document.activeElement);

      rootEl.classList.remove("is-open");
      triggerEl.hidden = false;
      inputEl.value = "";
      closePanel();
      renderStatus("");
      clearResults();

      if (restoreFocus) {
        triggerEl.focus();
      }
    }

    triggerEl.addEventListener("click", openSearch);
    closeBtnEl.addEventListener("click", () => closeSearch({ restoreFocus: true }));

    function isEditableTarget(target: EventTarget | null): boolean {
      if (!(target instanceof HTMLElement)) {
        return false;
      }

      return target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName);
    }

    document.addEventListener("keydown", (event: KeyboardEvent) => {
      const key = event.key.toLowerCase();
      const isSlashShortcut = event.key === "/" && !event.metaKey && !event.ctrlKey && !event.altKey;
      const isSearchShortcut = key === "k" && (event.metaKey || event.ctrlKey) && !event.altKey;

      if (!isSlashShortcut && !isSearchShortcut) {
        return;
      }

      if (isEditableTarget(event.target)) {
        return;
      }

      event.preventDefault();
      if (!rootEl.classList.contains("is-open")) {
        openSearch();
        return;
      }

      inputEl.focus();
      inputEl.select();
    });

    function renderResults(results: SearchIndexItem[]): void {
      clearResults();
      currentResults = results;

      if (results.length === 0) {
        return;
      }

      const fragment = document.createDocumentFragment();

      results.forEach((item, index) => {
        const li = document.createElement("li");
        li.className = RESULT_ITEM_CLASS;
        li.id = `site-search-result-${index}`;
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", "false");

        const link = document.createElement("a");
        link.className = RESULT_LINK_CLASS;
        link.href = item.url;
        if (index === 0) {
          link.dataset.searchFirst = "true";
        }

        const topRow = document.createElement("div");
        topRow.className = RESULT_TOP_CLASS;

        const title = document.createElement("span");
        title.className = RESULT_TITLE_CLASS;
        title.textContent = item.title;

        const badge = document.createElement("span");
        badge.className = `${RESULT_TYPE_CLASS} header-search-result-type--${item.type}`;
        badge.textContent = SEARCH_TYPE_LABELS[item.type] ?? item.type;

        topRow.append(title, badge);
        link.append(topRow);

        const summaryText =
          truncateText(item.summary ?? "", 60) ||
          (item.keywords.length > 0
            ? `${MESSAGES.keywords}${item.keywords.slice(0, 3).join(" / ")}`
            : "");

        if (summaryText) {
          const summary = document.createElement("p");
          summary.className = RESULT_SUMMARY_CLASS;
          summary.textContent = summaryText;
          link.append(summary);
        }

        li.append(link);
        fragment.append(li);
      });

      listEl.append(fragment);
      setActiveIndex(0);
    }

    async function updateSearchResults(): Promise<void> {
      const token = ++renderToken;
      const query = inputEl.value.trim();

      if (!query) {
        renderStatus("");
        clearResults();
        closePanel();
        return;
      }

      openPanel();
      renderStatus(MESSAGES.loading);

      try {
        const items = await ensureSearchIndexLoaded();
        if (token !== renderToken) {
          return;
        }

        const results = searchIndexItems(items, query, 8);
        renderResults(results);

        if (results.length === 0) {
          renderStatus(MESSAGES.none);
        } else {
          renderStatus(MESSAGES.resultCount(results.length));
        }
      } catch {
        if (token !== renderToken) {
          return;
        }

        renderStatus(MESSAGES.loadError);
        clearResults();
      }
    }

    inputEl.addEventListener("focus", () => {
      void ensureSearchIndexLoaded().catch(() => undefined);
      if (inputEl.value.trim()) {
        void updateSearchResults();
      }
    });

    inputEl.addEventListener("input", () => {
      void updateSearchResults();
    });

    inputEl.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        closeSearch({ restoreFocus: true });
        return;
      }

      if (event.key === "ArrowDown" && currentResults.length > 0) {
        event.preventDefault();
        openPanel();
        setActiveIndex(activeIndex + 1);
        return;
      }

      if (event.key === "ArrowUp" && currentResults.length > 0) {
        event.preventDefault();
        openPanel();
        setActiveIndex(activeIndex <= 0 ? currentResults.length - 1 : activeIndex - 1);
        return;
      }

      if (event.key === "Enter" && inputEl.value.trim()) {
        if (currentResults.length > 0) {
          event.preventDefault();
          navigateToActiveResult();
        }
      }
    });

    document.addEventListener("pointerdown", (event: PointerEvent) => {
      const target = event.target;
      if (target instanceof Node && !rootEl.contains(target)) {
        if (rootEl.classList.contains("is-open")) {
          closeSearch();
        }
      }
    });

    rootEl.addEventListener("click", (event: MouseEvent) => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }

      const link = target.closest("a");
      if (link instanceof HTMLAnchorElement && rootEl.contains(link)) {
        closeSearch();
      }
    });

    renderStatus("");
    closePanel();
  }

  document.querySelectorAll("[data-header-search]").forEach((root) => initHeaderSearch(root));
</script>
