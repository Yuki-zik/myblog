---
import { getLocale, createTranslator, localizePath, localizeData, localizeStructuredData } from "../lib/i18n/index";
import { createPageLocalizer, languageAlternates, pageTranslationStatus } from "../lib/i18n/content";
const locale = getLocale(Astro.url.pathname);
const translation = locale === "en" ? await pageTranslationStatus(Astro.url.pathname) : undefined;
const t = createTranslator(locale);
const l = await createPageLocalizer(locale);
const SITE_AUTHOR_PROFILE = localizeData(SOURCE_SITE_AUTHOR_PROFILE, locale);
const SITE_NAME = localizeData(SOURCE_SITE_NAME, locale);
const SITE_DESCRIPTION = localizeData(SOURCE_SITE_DESCRIPTION, locale);

import "../styles/tailwind.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/animations.css";
import "../styles/layout.css";
import "../styles/i18n.css";
import "../styles/translation-status.css";
import "../styles/search.css";
import "../styles/theme-toggle.css";
import "../styles/cards.css";
import "../styles/home.css";
import "../styles/home-reference.css";
import "../styles/toc.css";
import "../styles/author.css";
import "../styles/archives.css";
import "../styles/back-to-top.css";
import "../styles/article.css";
import "../styles/papers.css";
import "../styles/code.css";
import "katex/dist/katex.min.css";
import "../styles/discover.css";
import "../styles/editorial-rhythm.css";
import "../styles/waline.css";
import "../styles/reading-drawing.css";
import "../styles/article-drawing.css";
import "../styles/paper-drawing.css";
import HomeReferenceFooter from "../components/home/HomeReferenceFooter.astro";
import HeaderSearch from "../components/search/HeaderSearch.astro";
import UiControllers from "../components/UiControllers.astro";
import { SITE_AUTHOR_PROFILE as SOURCE_SITE_AUTHOR_PROFILE, SITE_NAME as SOURCE_SITE_NAME, SITE_DESCRIPTION as SOURCE_SITE_DESCRIPTION } from "../lib/site";
import { buildBaseNodes, serializeJsonLd, type JsonLdNode } from "../lib/seo/jsonLd";

interface Props {
  title: string;
  description?: string;
  authorMeta?: string;
  canonical?: string;
  noindex?: boolean;
  metaType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  openGraphImage?: string;
  runtime: "discover" | "reading";
  bodyClass?: string;
  mainClass?: string;
  headerVariant?: "default" | "drawing";
  hideFooter?: boolean;
  footerVariant?: "discover" | "reading" | "none";
  /**
   * Page-specific schema.org nodes (e.g. BlogPosting, CollectionPage,
   * BreadcrumbList). WebSite + Person are always emitted by the layout, so
   * callers only pass the extra nodes that reference those shared @ids.
   */
  structuredData?: JsonLdNode[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  authorMeta = SITE_AUTHOR_PROFILE.name,
  canonical,
  noindex = false,
  metaType = "website",
  publishedTime,
  modifiedTime,
  openGraphImage,
  runtime,
  bodyClass,
  mainClass,
  headerVariant = "drawing",
  hideFooter = false,
  footerVariant: explicitFooterVariant,
  structuredData
} = Astro.props;

const documentTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

const footerVariant = hideFooter
  ? "none"
  : explicitFooterVariant ?? (runtime === "discover" ? "discover" : "reading");

const pathname = localizePath(Astro.url.pathname, "zh-CN");
const alternates = noindex ? [] : await languageAlternates(Astro.url.pathname);
const otherLanguage = alternates.find(item => item.lang === (locale === "en" ? "zh-CN" : "en"));
const currentSection = pathname === "/map" || pathname === "/map/"
  ? "explore"
  : pathname === "/"
  ? "home"
  : pathname.startsWith("/topics") || pathname.startsWith("/posts") || pathname.startsWith("/concepts")
    ? "topics"
    : pathname.startsWith("/papers")
      ? "papers"
    : pathname.startsWith("/archives")
      ? "archives"
      : pathname.startsWith("/author")
        ? "author"
        : "";

const navItems = [
  { href: "/", label: t("首页"), section: "home" },
  { href: "/topics", label: t("主题"), section: "topics" },
  { href: "/papers", label: t("论文"), section: "papers" },
  { href: "/map", label: t("漫游"), section: "explore" },
  { href: "/archives", label: t("归档"), section: "archives" },
  { href: "/author", label: t("作者"), section: "author" }
];

function resolveAbsoluteUrl(value: string | undefined): string | undefined {
  const site = Astro.site;
  if (!site || !value) {
    return undefined;
  }

  try {
    return new URL(value, site).toString();
  } catch {
    return undefined;
  }
}

const canonicalUrl = resolveAbsoluteUrl(l(canonical ?? (Astro.url.pathname.replace(/\/+$/, "") || "/")));
const rssUrl = resolveAbsoluteUrl(l("/rss.xml"));
const openGraphImageUrl = resolveAbsoluteUrl(locale === "en" && openGraphImage?.startsWith("/og/") ? openGraphImage.replace("/og/", "/og/en/") : openGraphImage);
const twitterCard = openGraphImage ? "summary_large_image" : "summary";
const fontStylesheetUrl = "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Noto+Serif+SC:wght@400;500;600;700;900&family=Outfit:wght@400;500;600;700;800;900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=Space+Grotesk:wght@500;600;700&display=swap";

const siteUrlString = Astro.site?.toString();
const jsonLdHtml = siteUrlString
  ? serializeJsonLd(localizeStructuredData([
      ...buildBaseNodes(siteUrlString, SITE_AUTHOR_PROFILE),
      ...(structuredData ?? [])
    ], locale, Astro.site!))
  : null;

const themeInitScript = `(function () {
  var root = document.documentElement;
  var storageKey = "theme-preference";
  var valid = { system: true, light: true, dark: true };
  var media = window.matchMedia("(prefers-color-scheme: dark)");
  var stored = null;
  try {
    stored = localStorage.getItem(storageKey);
  } catch {
    // Blocked storage still follows the system theme on this page.
  }
  var preference = stored && valid[stored] ? stored : "system";
  var resolved = preference === "system" ? (media.matches ? "dark" : "light") : preference;
  root.dataset.theme = preference;
  root.dataset.colorScheme = resolved;
  root.style.colorScheme = resolved;
})();`;
---

<!doctype html>
<html lang={locale} class="no-js" data-theme="system" data-color-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}
    <meta name="author" content={authorMeta} />
    {locale === "zh-CN" && pathname === "/" ? <meta name="baidu-site-verification" content="codeva-WhDD0PxDx9" /> : null}
    <link rel="icon" type="image/svg+xml" href={l("/favicon.svg")} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    {alternates.map(item => <link rel="alternate" hreflang={item.lang} href={resolveAbsoluteUrl(item.path)} />)}
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href={l(rssUrl ?? "/rss.xml")} />

    <!-- Open Graph -->
    <meta property="og:title" content={documentTitle} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={metaType} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "zh_CN"} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {openGraphImageUrl ? <meta property="og:image" content={openGraphImageUrl} /> : null}
    {
      metaType === "article" && publishedTime ? (
        <meta property="article:published_time" content={publishedTime} />
      ) : null
    }
    {
      metaType === "article" && modifiedTime ? (
        <meta property="article:modified_time" content={modifiedTime} />
      ) : null
    }

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    {openGraphImageUrl ? <meta name="twitter:image" content={openGraphImageUrl} /> : null}

    {
      jsonLdHtml ? (
        <script type="application/ld+json" is:inline set:html={jsonLdHtml} />
      ) : null
    }

    <!-- Google Fonts: Space Grotesk (UI chrome) + Source Serif 4 (reading) -->
    <link rel="preconnect" href={l("https://fonts.googleapis.com")} />
    <link rel="preconnect" href={l("https://fonts.gstatic.com")} crossorigin />
    <link rel="stylesheet" href={l(fontStylesheetUrl)} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={l(fontStylesheetUrl)} />
    </noscript>

    <script is:inline set:html={themeInitScript} />
  </head>
  <body class={bodyClass} data-runtime={runtime} data-header-variant={headerVariant} data-translation-state={translation?.state}>
    <header class="site-header sticky top-0 z-80" data-header-state="top" data-header-variant={headerVariant}>
      <div class="site-header-surface-clip" aria-hidden="true">
        <div class="site-header-inner isolate overflow-hidden origin-top"></div>
      </div>
      <div class="shell grid items-center text-chrome-ink">
        <a href={l("/")} class="brand justify-self-start font-display font-[650] leading-none tracking-[-0.03em]">{SITE_NAME}</a>
        <div class="site-header-search-slot w-full min-w-0" data-header-search-slot>
          <HeaderSearch />
{otherLanguage && <a class="language-switch" href={otherLanguage.path} lang={otherLanguage.lang} hreflang={otherLanguage.lang} aria-label={locale === "en" ? "阅读中文版本" : "Read this page in English"} title={locale === "en" ? "中文版本" : "English version"} data-language-switch>{locale === "en" ? "中文" : "EN"}</a>}
        </div>
        <nav class="site-nav justify-self-end flex items-center min-w-0 gap-[0.65rem]">
          <div class="site-nav-links flex items-center min-w-0 gap-[0.12rem]">
            {navItems.map((item) => (
              <a
                href={l(item.href)}
                class="inline-flex items-center min-h-8 rounded-full py-[0.36rem] px-[0.62rem] text-[0.84rem] font-[560] tracking-[-0.02em]"
                aria-current={currentSection === item.section ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
          <div class="site-nav-tools flex items-center gap-[0.36rem]">
            <button
              id="theme-toggle"
              type="button"
              class="theme-toggle inline-flex items-center justify-center flex-none size-[2.28rem] rounded-full border p-0 cursor-pointer"
              aria-label={t("切换主题（当前：跟随系统）")}
              aria-live="polite"
              title={t("切换主题")}
            >
              <span class="theme-toggle-icon inline-flex items-center justify-center size-[0.92rem]" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4.1"></circle>
                  <path d="M12 2.8v2.3"></path>
                  <path d="M12 18.9v2.3"></path>
                  <path d="M4.8 4.8l1.6 1.6"></path>
                  <path d="M17.6 17.6l1.6 1.6"></path>
                  <path d="M2.8 12h2.3"></path>
                  <path d="M18.9 12h2.3"></path>
                  <path d="M4.8 19.2l1.6-1.6"></path>
                  <path d="M17.6 6.4l1.6-1.6"></path>
                </svg>
              </span>
              <span class="theme-toggle-label sr-only">{t("系统")}</span>
            </button>
          </div>
        </nav>
      </div>
    </header>
	    <main class:list={["shell", mainClass]} data-runtime={runtime}>
	      {translation && ["stale", "untracked"].includes(translation.state) && (
        <aside class="translation-status" data-translation-notice role="status">
          <strong>{translation.state === "stale" ? "English update pending" : "Translation synchronization pending"}</strong>
          <span>The Chinese original has the latest version. This English edition remains available while its update is checked.</span>
          <a href={translation.sourcePath} lang="zh-CN">Read the latest Chinese version ↗</a>
        </aside>
      )}
      <slot />
	    </main>
	    {
	      footerVariant === "none"
	        ? null
	        : <HomeReferenceFooter variant={footerVariant === "discover" ? "discover" : "reading"} />
	    }

    <!-- Back to Top -->
    <button
      id="back-to-top"
      type="button"
      class="back-to-top fixed right-[1.3rem] bottom-[1.35rem] z-60 inline-flex items-center justify-center size-[2.8rem] rounded-full border border-fab-edge bg-fab text-fab-icon shadow-fab cursor-pointer"
      aria-label={t("回到顶部")}
      title={t("回到顶部")}
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <UiControllers />
  </body>
</html>
