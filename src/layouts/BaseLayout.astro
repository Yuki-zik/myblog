---
import "../styles/tailwind.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/animations.css";
import "../styles/layout.css";
import "../styles/search.css";
import "../styles/theme-toggle.css";
import "../styles/cards.css";
import "../styles/home.css";
import "../styles/home-reference.css";
import "../styles/toc.css";
import "../styles/author.css";
import "../styles/archives.css";
import "../styles/back-to-top.css";
import "../styles/article.css";
import "../styles/papers.css";
import "../styles/code.css";
import "katex/dist/katex.min.css";
import "../styles/discover.css";
import "../styles/graph.css";
import "../styles/waline.css";
import HomeReferenceFooter from "../components/home/HomeReferenceFooter.astro";
import HeaderSearch from "../components/search/HeaderSearch.astro";
import UiControllers from "../components/UiControllers.astro";
import { SITE_AUTHOR_PROFILE } from "../lib/site";
import { buildBaseNodes, serializeJsonLd, type JsonLdNode } from "../lib/seo/jsonLd";

interface Props {
  title: string;
  description?: string;
  authorMeta?: string;
  canonical?: string;
  metaType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  openGraphImage?: string;
  runtime: "discover" | "reading";
  mainClass?: string;
  hideFooter?: boolean;
  footerVariant?: "discover" | "reading" | "none";
  /**
   * Page-specific schema.org nodes (e.g. BlogPosting, CollectionPage,
   * BreadcrumbList). WebSite + Person are always emitted by the layout, so
   * callers only pass the extra nodes that reference those shared @ids.
   */
  structuredData?: JsonLdNode[];
}

const {
  title,
  description = "\u4e3b\u9898\u5316\u77e5\u8bc6\u7f51\u7edc\u4e0e\u6bb5\u843d\u77ed\u8bc4\u535a\u5ba2",
  authorMeta = SITE_AUTHOR_PROFILE.name,
  canonical,
  metaType = "website",
  publishedTime,
  modifiedTime,
  openGraphImage,
  runtime,
  mainClass,
  hideFooter = false,
  footerVariant: explicitFooterVariant,
  structuredData
} = Astro.props;

const footerVariant = hideFooter
  ? "none"
  : explicitFooterVariant ?? (runtime === "discover" ? "discover" : "reading");

const pathname = Astro.url.pathname;
const currentSection = pathname === "/"
  ? "home"
  : pathname.startsWith("/topics") || pathname.startsWith("/posts") || pathname.startsWith("/concepts")
    ? "topics"
    : pathname.startsWith("/papers")
      ? "papers"
    : pathname.startsWith("/archives")
      ? "archives"
      : pathname.startsWith("/author")
        ? "author"
        : "";

const navItems = [
  { href: "/", label: "\u9996\u9875", section: "home" },
  { href: "/topics", label: "\u4e3b\u9898", section: "topics" },
  { href: "/papers", label: "\u8bba\u6587", section: "papers" },
  { href: "/archives", label: "\u5f52\u6863", section: "archives" },
  { href: "/author", label: "\u4f5c\u8005", section: "author" }
];

function resolveAbsoluteUrl(value: string | undefined): string | undefined {
  const site = Astro.site;
  if (!site || !value) {
    return undefined;
  }

  try {
    return new URL(value, site).toString();
  } catch {
    return undefined;
  }
}

const canonicalUrl = resolveAbsoluteUrl(canonical ?? pathname);
const openGraphImageUrl = resolveAbsoluteUrl(openGraphImage);
const twitterCard = openGraphImage ? "summary_large_image" : "summary";

const siteUrlString = Astro.site?.toString();
const jsonLdHtml = siteUrlString
  ? serializeJsonLd([
      ...buildBaseNodes(siteUrlString, SITE_AUTHOR_PROFILE),
      ...(structuredData ?? [])
    ])
  : null;

const themeInitScript = `(function () {
  var root = document.documentElement;
  var storageKey = "theme-preference";
  var valid = { system: true, light: true, dark: true };
  var media = window.matchMedia("(prefers-color-scheme: dark)");
  var stored = localStorage.getItem(storageKey);
  var preference = stored && valid[stored] ? stored : "system";
  var resolved = preference === "system" ? (media.matches ? "dark" : "light") : preference;
  root.dataset.theme = preference;
  root.dataset.colorScheme = resolved;
  root.style.colorScheme = resolved;
})();`;
---

<!doctype html>
<html lang="zh-CN" class="no-js" data-theme="system" data-color-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={authorMeta} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={metaType} />
    <meta property="og:locale" content="zh_CN" />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {openGraphImageUrl ? <meta property="og:image" content={openGraphImageUrl} /> : null}
    {
      metaType === "article" && publishedTime ? (
        <meta property="article:published_time" content={publishedTime} />
      ) : null
    }
    {
      metaType === "article" && modifiedTime ? (
        <meta property="article:modified_time" content={modifiedTime} />
      ) : null
    }

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {openGraphImageUrl ? <meta name="twitter:image" content={openGraphImageUrl} /> : null}

    {
      jsonLdHtml ? (
        <script type="application/ld+json" is:inline set:html={jsonLdHtml} />
      ) : null
    }

    <!-- Google Fonts: Space Grotesk (UI chrome) + Source Serif 4 (reading) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Noto+Serif+SC:wght@400;500;600;700;900&family=Outfit:wght@400;500;600;700;800;900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=Space+Grotesk:wght@500;600;700&display=swap" />

    <script is:inline set:html={themeInitScript} />
  </head>
  <body data-runtime={runtime}>
    <header class="site-header sticky top-0 z-80" data-header-state="top">
      <div class="site-header-surface-clip" aria-hidden="true">
        <div class="site-header-inner isolate overflow-hidden origin-top"></div>
      </div>
      <div class="shell grid items-center text-chrome-ink">
        <a href="/" class="brand justify-self-start font-display font-[650] leading-none tracking-[-0.03em]">MyBlog</a>
        <div class="site-header-search-slot w-full min-w-0" data-header-search-slot>
          <HeaderSearch />
        </div>
        <nav class="site-nav justify-self-end flex items-center min-w-0 gap-[0.65rem]">
          <div class="site-nav-links flex items-center min-w-0 gap-[0.12rem]">
            {navItems.map((item) => (
              <a
                href={item.href}
                class="inline-flex items-center min-h-8 rounded-full py-[0.36rem] px-[0.62rem] text-[0.84rem] font-[560] tracking-[-0.02em]"
                aria-current={currentSection === item.section ? "page" : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
          <div class="site-nav-tools flex items-center gap-[0.36rem]">
            <button
              id="theme-toggle"
              type="button"
              class="theme-toggle inline-flex items-center justify-center flex-none size-[2.28rem] rounded-full border p-0 cursor-pointer"
              aria-label="切换主题（当前：跟随系统）"
              aria-live="polite"
              title="切换主题"
            >
              <span class="theme-toggle-icon inline-flex items-center justify-center size-[0.92rem]" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4.1"></circle>
                  <path d="M12 2.8v2.3"></path>
                  <path d="M12 18.9v2.3"></path>
                  <path d="M4.8 4.8l1.6 1.6"></path>
                  <path d="M17.6 17.6l1.6 1.6"></path>
                  <path d="M2.8 12h2.3"></path>
                  <path d="M18.9 12h2.3"></path>
                  <path d="M4.8 19.2l1.6-1.6"></path>
                  <path d="M17.6 6.4l1.6-1.6"></path>
                </svg>
              </span>
              <span class="theme-toggle-label sr-only">系统</span>
            </button>
          </div>
        </nav>
      </div>
    </header>
	    <main class:list={["shell", mainClass]} data-runtime={runtime}>
	      <slot />
	    </main>
	    {
	      footerVariant === "none"
	        ? null
	        : <HomeReferenceFooter variant={footerVariant === "discover" ? "discover" : "reading"} />
	    }

    <!-- Back to Top -->
    <button
      id="back-to-top"
      type="button"
      class="back-to-top fixed right-[1.3rem] bottom-[1.35rem] z-60 inline-flex items-center justify-center size-[2.8rem] rounded-full border border-fab-edge bg-fab text-fab-icon shadow-fab cursor-pointer"
      aria-label="回到顶部"
      title="回到顶部"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <UiControllers />
  </body>
</html>
