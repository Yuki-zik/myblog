{
  "name": "myblog-waline-server",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Waline server deployment unit for MyBlog",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node node_modules/@waline/vercel/vanilla.js",
    "start": "node node_modules/@waline/vercel/vanilla.js",
    "smoke": "node smoke.cjs"
  },
  "dependencies": {
    "@waline/vercel": "1.40.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "protobufjs",
      "sqlite3"
    ],
    "overrides": {
      "form-data@<2.5.6": "2.5.6",
      "form-data@>=3.0.0 <3.0.5": "3.0.5",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "protobufjs": "^7.6.5",
      "axios": "^0.33.0",
      "brace-expansion@<1.1.17": "1.1.17",
      "dompurify": "^3.4.11",
      "linkify-it": "^5.0.2",
      "nodemailer": "^9.0.1",
      "tar": "^7.5.21",
      "validator": "^13.15.23",
      "ws": "^8.20.1",
      "qs": "^6.15.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-p6mc-m468-83gw",
        "GHSA-p8p7-x288-28g6",
        "GHSA-72xf-g2v4-qvf3",
        "GHSA-w9mr-4mfr-499f",
        "GHSA-xxjr-mmjv-4gpg",
        "GHSA-f23m-r3pf-42rh",
        "GHSA-w5hq-g745-h8pq"
      ]
    }
  }
}
