# Public env exposed to the browser.
# Local dev:
# - leave empty to disable comments safely, or point to your local/preview Waline server.
# Preview:
# - set this to your preview Waline deployment URL.
# Production:
# - set this to your canonical Waline comment domain.
PUBLIC_WALINE_SERVER_URL=https://comments.example.com

# Build-time canonical origin.
# Consumed by astro.config.mjs as Astro `site`, which is what makes canonical
# links and Open Graph / Twitter image URLs absolute. Leave it unset locally and
# those tags are silently omitted; set it in Preview and Production.
SITE_URL=https://myblog.example.com
