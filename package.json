{
  "name": "myblog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:waline-server": "pnpm --dir waline-server smoke",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "audit:waline-server": "pnpm --dir waline-server audit --prod --audit-level moderate",
    "audit:all": "pnpm audit:prod && pnpm audit:waline-server",
    "test:all": "pnpm test && pnpm build && pnpm test:waline-server && pnpm audit:all && pnpm test:e2e"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/react": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@waline/client": "^3.15.0",
    "astro": "^6.4.2",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "d3-force": "^3.0.0",
    "github-slugger": "^2.0.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "rollup": "^4.59.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "fast-xml-builder": "1.1.7",
      "devalue": "^5.8.1",
      "smol-toml": "^1.6.1",
      "yaml": "^2.8.3",
      "postcss": "^8.5.15"
    }
  }
}
